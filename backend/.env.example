NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-em-hexadecimal
REQUIRE_EMAIL_VERIFICATION=true
SOCKET_EVENTS_PER_MINUTE=60

# URLs e tenant do site público
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_TENANT_SLUG=saudepet
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Analytics próprio. Use um valor aleatório e estável; nunca publique o valor real.
ANALYTICS_HASH_SALT=gere-um-salt-longo-e-aleatorio
ANALYTICS_RETENTION_DAYS=180

# Descoberta e atualização de conteúdo em mecanismos compatíveis com IndexNow.
# A chave deve ser aleatória, mantida apenas no ambiente e nunca versionada.
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Webhook opcional para o fluxo de SEO no n8n (publicação, atualização e remoção).
N8N_SEO_WEBHOOK_URL=
# Chave servidor-servidor usada apenas pelo n8n em /api/v1/automation/*.
N8N_AUTOMATION_API_KEY=

# Data ISO usada no sitemap para páginas institucionais quando o conteúdo mudar.
STATIC_CONTENT_LASTMOD=2026-08-19

# E-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Armazenamento de documentos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Retencao dos anexos do chat no R2 (anexo-retencao.worker.js, 1x por dia).
# Dias entre a exclusao logica da mensagem e a remocao do BINARIO no bucket.
# A linha em `mensagens_anexos` nunca e apagada: a auditoria da conversa e
# intencional, some so o arquivo e a coluna `arquivo_removido_em` registra
# quando. Aceita de 7 a 3650; fora da faixa, o valor e limitado ao extremo.
# O mesmo worker varre objetos sob o prefixo `chat/` com mais de 24h e sem
# linha correspondente no banco (anexos orfaos de upload que falhou ao gravar).
ANEXO_RETENCAO_DIAS=90

# Serviços opcionais já existentes
# ANTHROPIC_API_KEY saiu em 26/08/2026: era lida só pela análise de documento
# do veterinário, nunca esteve configurada em produção (a análise nunca rodou
# uma vez), e aquele serviço passou a usar OPENAI_API_KEY — que a casa tem.
CIDADE_INICIAL=

# ═══════════════════════════════════════════════════════
# Integração Meta (app "Saúde Pet Brasil" no Meta for Developers)
# Ver ROADMAP.md → "Integração Meta" pra passo a passo e o que cada uma ativa.
# Tudo aqui é opcional: enquanto vazio, a funcionalidade correspondente
# fica desligada silenciosamente (nenhuma chamada é feita, nada quebra).
# ═══════════════════════════════════════════════════════

# Comum a Lead Ads e WhatsApp (webhook único em /api/v1/webhooks/meta)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Cloud API (envio/recebimento de mensagens)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_TEMPLATE_SOLICITACAO_ACEITA=solicitacao_aceita

# Facebook Login (usa META_APP_ID/META_APP_SECRET acima)
# Precisa de "Domínios do aplicativo" preenchido no painel Meta.

# Conversions API (rastreamento server-side de conversão)
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_CONVERSIONS_TEST_CODE=

# Threads (publicar posts do blog automaticamente)
META_THREADS_USER_ID=
META_THREADS_ACCESS_TOKEN=

# ═══════════════════════════════════════════════════════
# Variáveis lidas pelo código que faltavam aqui (26/08/2026)
# Uma varredura comparou `process.env.*` no código com este arquivo: 30 nomes
# eram lidos em produção sem estar documentados em lugar nenhum, e 5 estavam
# documentados sem ninguém ler (REDIS_* e TEMPO_URL, removidos acima).
# Quem subisse um ambiente novo copiando este arquivo ficava sem e-mail, sem
# push, sem login Google e sem videochamada atrás de NAT — tudo em silêncio.
# ═══════════════════════════════════════════════════════

# --- Identidade da instalação ---
# Slug do tenant padrão. Sem ele, cadastros caem no fallback do código.
TENANT_SLUG=
AUTH_TENANT_SLUG=
# Base pública da API (links absolutos em e-mail e webhook).
API_URL=https://saudepet.app.br/api
# Onde o backend acha o build do frontend quando serve os dois no mesmo container.
FRONTEND_INDEX_PATH=
# Fuso usado só para EXIBIR data e hora ao usuário; o banco continua em UTC.
TZ_EXIBICAO=America/Sao_Paulo

# --- E-mail ---
# Caixa própria do Saúde Pet no mail.avilaops.com: `noreply@saudepet.app.br`,
# em uso desde 27/08/2026. O domínio já tem SPF (include:_spf.avilaops.com),
# DKIM (seletor `avila`, por CNAME) e DMARC p=reject — alinha nos três.
#
# A caixa nasceu com `mustChangePassword: false`, e isso não é detalhe: toda
# caixa criada pelo fluxo normal exige definir a senha no primeiro acesso, e
# no instante em que alguém fizesse isso o envio do aplicativo pararia de
# autenticar SEM ERRO EM TELA NENHUMA — cadastro sem boas-vindas, reset que
# nunca chega, receita que não sai. Uma caixa transacional não pode depender
# de ninguém abrir um webmail.
# Remetente. `SMTP_PASSWORD` é o nome alternativo aceito para `SMTP_PASS`.
EMAIL_FROM=
SMTP_PASSWORD=
# Para onde vão os alertas operacionais (falha de pagamento, erro de worker).
ADMIN_ALERT_EMAIL=
# Provedor alternativo de envio; vazio = usa SMTP.
RESEND_API_KEY=

# --- Login social (Google) ---
# Vazio = o botão do Google aparece desativado com aviso na tela de login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT ---
# Preenchidos, passam a ser exigidos na validação do token.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Papel de quem se cadastra sem tipo declarado.
AUTH_DEFAULT_ROLE=tutor

# --- Push (Web Push / VAPID) ---
# Sem o par de chaves, NENHUMA notificação push sai — o app avisa só na tela
# aberta. Gere com: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo (mailto: ou URL do responsável).
WEB_PUSH_CONTACT=mailto:contato@saudepet.app.br

# --- Videochamada (WebRTC) ---
# STUN resolve a maioria dos casos; TURN é o que salva quem está atrás de NAT
# simétrico ou rede corporativa. Sem TURN, uma parte das chamadas simplesmente
# não conecta — e o sintoma é "chamou e ficou preto", não um erro.
#
# Em produção há um coturn no próprio servidor desde 27/08/2026 (porta 3478
# UDP/TCP, relay em 49160-49200, config em /etc/turnserver.conf). Provado de
# fora com `scripts/prova-turn.ts`: recusa Allocate sem credencial (401) e
# aloca relay com credencial — as duas metades importam, porque TURN que aloca
# sem credencial é proxy aberto para o mundo inteiro usar de graça.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Mapas e rotas ---
# Nominatim exige identificação de quem chama; sem isso o serviço bloqueia.
GEOCODING_USER_AGENT=SaudePet/1.0 (contato@saudepet.app.br)
# Roteamento por rua para o tempo de chegada. Vazio = distância em linha reta.
OSRM_URL=

# --- Transcrição de voz (ditado do prontuário) ---
# Serviço próprio (faster-whisper), em ferramentas/voz/servico-transcricao.
# Áudio nunca sai da infraestrutura própria; sem custo por minuto.
TRANSCRICAO_API_URL=http://127.0.0.1:8100
TRANSCRICAO_TIMEOUT_MS=30000

# --- Frete nacional (CepCerto) ---
# Apenas no backend. Nunca crie variável VITE_ com esta chave.
# Em desenvolvimento, o servidor também procura ~/.avilaops/cepcerto.env.
CEP_CERTO_POSTAGEM_API_KEY=
# Opcional para apontar a integração a outro ambiente (ex.: sandbox).
CEP_CERTO_API_URL=https://cepcerto.com
CEP_CERTO_TIMEOUT_MS=12000

# --- IA (texto de apoio e triagem) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Meta (versão da Graph API e token da página) ---
META_GRAPH_API_VERSION=v21.0
META_PAGE_ACCESS_TOKEN=

# --- Asaas (provedor de pagamento alternativo ao Mercado Pago) ---
# Desde 26/08/2026 o gateway do Asaas FALHA sem credencial em vez de fingir
# sucesso. Deixe vazio se a operação é só Mercado Pago — o que é o caso hoje.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Sem este segredo o webhook /api/webhooks/asaas recusa qualquer chamada.
ASAAS_WEBHOOK_SECRET=
