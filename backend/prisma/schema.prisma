model LembretePet {
  id            String   @id @default(uuid())
  tenant_id     String
  tutor_id      String
  pet_id        String
  titulo        String // "Vacina V10", "Dar Vermífugo", "Consulta de retorno"
  tipo          String // vacina, medicamento, retorno, higienizacao
  data_lembrete DateTime
  concluido     Boolean  @default(false)
  notificado    Boolean  @default(false)
  criado_em     DateTime @default(now())

  // Quem pediu o retorno. Nulo nos lembretes que o próprio tutor cria e nos
  // que já existiam antes desta coluna. Sem ele, o e-mail de retorno saía
  // assinado com a string literal "veterinário responsável" — o tutor não
  // conseguia sequer saber qual vet o chamou de volta.
  veterinario_id String?
  // Mensagem que o vet escreve ao convocar o retorno; sai no e-mail.
  mensagem       String?

  pet         Pet          @relation(fields: [pet_id], references: [id], onDelete: Cascade)
  veterinario Veterinario? @relation(fields: [veterinario_id], references: [id], onDelete: SetNull)

