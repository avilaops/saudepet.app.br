/// Mídia do atendimento: o que a descrição escrita não mostra.
///
/// Duas origens, um lugar só. O TUTOR anexa ao pedir socorro — a foto da ferida,
/// o vídeo da convulsão, o áudio da respiração —, e é isso que o veterinário
/// olha antes de aceitar. O VETERINÁRIO anexa durante a consulta, e é isso que
/// permite comparar a lesão no retorno.
///
/// Antes, nada disso existia: o tutor só conseguia mandar arquivo pelo chat,
/// que só abre DEPOIS que alguém aceita, e a foto do veterinário ia para o mesmo
/// chat — onde a retenção de 90 dias a apagava. Registro clínico não expira
/// junto com bate-papo.
///
/// Guardamos a chave do R2, nunca a URL pública: o acesso é sempre por URL
/// assinada de curta duração. Quem lê são os participantes do atendimento, o
/// admin do tenant e — enquanto ninguém aceitou — os veterinários aprovados do
/// tenant, que precisam ver para decidir. É dado sensível de saúde: não entra na
/// tag pública da coleira.
model MidiaAtendimento {
  id             String @id @default(uuid())
  tenant_id      String
  atendimento_id String

  /// Quem enviou, e em que papel. O papel importa na leitura: a mídia do tutor
  /// é relato, a do veterinário é registro clínico.
  autor_usuario_id String
  autor_papel      String // tutor | veterinario
  /// Preenchido quando quem enviou é o profissional do atendimento.
  veterinario_id   String?

  storage_key   String
  nome_original String
  mime_type     String
  tamanho_bytes Int
  tipo          String // imagem | video | audio
  /// O que o arquivo mostra ("lesão no membro anterior direito", "tosse desde
  /// ontem"). Sem isso, um álbum solto não diz nada a quem atender depois.
  legenda       String?  @db.Text
  criado_em     DateTime @default(now())

  atendimento Solicitacao  @relation(fields: [atendimento_id], references: [id], onDelete: Cascade)
  veterinario Veterinario? @relation(fields: [veterinario_id], references: [id])

  @@index([tenant_id])
  @@index([atendimento_id])
  @@map("midias_atendimento")
}

/// Gravação de uma teleorientação, guardada para auditoria interna.
///
/// TODA chamada é gravada — decisão do Nicolas em 27/08/2026, e a razão é
/// controle de risco, não curiosidade: numa consulta por vídeo entre um
/// profissional e um cliente, quando alguém denuncia abuso ou quebra de regra
/// o que existe hoje são duas versões e nada mais. Sem gravação, a primeira
/// denúncia séria é justamente a que não dá para apurar.
///
/// O que NÃO é: não é conteúdo do produto. Nem o tutor nem o veterinário têm
/// player, link ou download. A gravação existe para a moderação abrir quando
/// houver denúncia, e todo acesso deixa rastro em `AuditLog` — auditoria que
/// ninguém audita é só um acervo.
///
/// Áudio, não vídeo: o que se apura numa denúncia de conduta é o que foi DITO,
/// e vídeo de consulta custa uma ordem de grandeza a mais em armazenamento
/// para responder a mesma pergunta. `GRAVAR_VIDEO` no serviço inverte isso.
model GravacaoChamada {
  id             String @id @default(uuid())
  tenant_id      String
  atendimento_id String

  /// Cada lado grava a própria versão da conversa. São duas por chamada, de
  /// propósito: se um navegador fecha no meio, a do outro lado sobrevive — e
  /// numa apuração de conduta perder metade é perder tudo.
  autor_usuario_id String
  autor_papel      String // tutor | veterinario

  /// Partes na ordem em que foram enviadas. A primeira carrega o cabeçalho do
  /// contêiner; tocar é concatenar na ordem. Subir em pedaços durante a
  /// chamada é o que evita perder tudo quando o aparelho desliga no meio.
  partes        GravacaoChamadaParte[]
  duracao_seg   Int?
  tamanho_bytes Int                    @default(0)
  mime_type     String                 @default("audio/webm")

  /// gravando | finalizada | interrompida
  /// `interrompida` é a chamada cujo navegador sumiu sem avisar — a varredura
  /// fecha depois do prazo. É estado normal, não erro: o material gravado até
  /// ali continua valendo.
  status String @default("gravando")

  iniciada_em   DateTime  @default(now())
  finalizada_em DateTime?

  /// LGPD: gravação de consulta é dado sensível e não pode ficar para sempre.
  /// A varredura apaga o áudio depois desta data; a LINHA fica, para o
  /// histórico mostrar que existiu uma gravação e que ela venceu.
  expira_em DateTime

  atendimento Solicitacao @relation(fields: [atendimento_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([atendimento_id])
  @@index([expira_em])
  @@map("gravacoes_chamada")
}

/// Um pedaço da gravação, do jeito que chegou do navegador.
model GravacaoChamadaParte {
  id            String   @id @default(uuid())
  gravacao_id   String
  /// Ordem de chegada. Fora de ordem, o áudio não toca.
  indice        Int
  storage_key   String
  tamanho_bytes Int
  criado_em     DateTime @default(now())

  gravacao GravacaoChamada @relation(fields: [gravacao_id], references: [id], onDelete: Cascade)

  @@unique([gravacao_id, indice])
  @@index([gravacao_id])
  @@map("gravacoes_chamada_partes")
}

model PrescricaoItem {
