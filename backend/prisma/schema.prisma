// ═══════════════════════════════════════════════════════
// REDE DE PARCEIROS, INDICAÇÕES & COMISSÕES DINÂMICAS
// ═══════════════════════════════════════════════════════

enum PartnerType {
  CLINIC
  HOSPITAL
  LABORATORY
  DIAGNOSTIC_CENTER
  PHARMACY
  PET_SHOP
  REHABILITATION
  OTHER
}

enum PartnerStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED
}

enum ReferralStatus {
  CREATED
  SENT
  VIEWED
  ACCEPTED
  SCHEDULED
  ATTENDED
  PENDING_CONFIRMATION
  CONVERTED
  CANCELLED
  EXPIRED
  DISPUTED
  REJECTED
}

enum CommissionType {
  PERCENTAGE
  FIXED
  PERCENTAGE_PLUS_FIXED
}

enum SettlementStatus {
  OPEN
  PENDING_REVIEW
  APPROVED
  DUE
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

model Partner {
  id               String        @id @default(cuid())
  tenantId         String
  legalName        String
  tradeName        String
  documentNumber   String        @unique
  partnerType      PartnerType   @default(CLINIC)
  description      String?       @db.Text
  email            String
  phone            String
  whatsapp         String?
  website          String?
  logoUrl          String?
  status           PartnerStatus @default(PENDING_REVIEW)
  approvalStatus   String        @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt       DateTime?
  approvedBy       String?
  suspendedAt      DateTime?
  suspensionReason String?
  rating           Decimal       @default(5.0) @db.Decimal(3, 2)
  totalReviews     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  units           PartnerUnit[]
  services        PartnerService[]
  commissionRules CommissionRule[]
  referrals       Referral[]
  settlements     CommissionSettlement[]
  reviews         PartnerReview[]
  users           PartnerUser[]

  @@index([tenantId, status, partnerType])
  @@map("partners")
}

model PartnerUnit {
  id               String   @id @default(cuid())
  partnerId        String
  name             String
  email            String?
  phone            String?
  whatsapp         String?
  addressLine      String
  addressNumber    String
  complement       String?
  district         String
  city             String
  state            String
  postalCode       String
  latitude         Float?
  longitude        Float?
  openingHours     String?
  emergencyService Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partner   Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  services  PartnerService[]
  referrals Referral[]
  users     PartnerUser[]

  @@index([partnerId, city, state])
  @@map("partner_units")
}

model PartnerCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  icon         String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  services PartnerService[]

  @@map("partner_categories")
}

model PartnerService {
  id                 String   @id @default(cuid())
  partnerId          String
  partnerUnitId      String?
  categoryId         String
  name               String
  description        String?  @db.Text
  publicPrice        Decimal  @db.Decimal(10, 2)
  priceType          String   @default("FIXED") // FIXED, STARTING_FROM, ESTIMATE
  requiresScheduling Boolean  @default(true)
  estimatedDuration  Int? // minutos
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  partner   Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  unit      PartnerUnit?    @relation(fields: [partnerUnitId], references: [id], onDelete: SetNull)
  category  PartnerCategory @relation(fields: [categoryId], references: [id])
  referrals Referral[]

  @@index([partnerId, categoryId])
  @@map("partner_services")
}

model CommissionRule {
  id                String         @id @default(cuid())
  tenantId          String
  partnerId         String?
  partnerUnitId     String?
  partnerServiceId  String?
  name              String
  calculationType   CommissionType @default(PERCENTAGE)
  percentage        Decimal        @default(10.00) @db.Decimal(5, 2)
  fixedAmount       Decimal        @default(0.00) @db.Decimal(10, 2)
  minimumCommission Decimal?       @db.Decimal(10, 2)
  maximumCommission Decimal?       @db.Decimal(10, 2)
  validFrom         DateTime       @default(now())
  validUntil        DateTime?
  priority          Int            @default(0)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, partnerId, active])
  @@map("commission_rules")
}

model Referral {
  id                 String         @id @default(cuid())
  tenantId           String
  referralCode       String         @unique // Ex: SP-2026-X89A
  tutorId            String
  petId              String
  partnerId          String
  partnerUnitId      String
  partnerServiceId   String?
  source             String         @default("APP_TUTOR")
  reason             String?        @db.Text
  status             ReferralStatus @default(CREATED)
  qrCodePayload      String         @db.Text
  scheduledAt        DateTime?
  attendedAt         DateTime?
  expiresAt          DateTime
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  partner     Partner              @relation(fields: [partnerId], references: [id])
  unit        PartnerUnit          @relation(fields: [partnerUnitId], references: [id])
  service     PartnerService?      @relation(fields: [partnerServiceId], references: [id])
  conversions ReferralConversion[]
  reviews     PartnerReview[]
  documents   ReferralDocument[]

  @@index([tenantId, tutorId])
  @@index([partnerId, status])
  @@index([referralCode])
  @@map("referrals")
}

model ReferralConversion {
  id                           String   @id @default(cuid())
  referralId                   String
  grossAmount                  Decimal  @db.Decimal(10, 2)
  eligibleAmount               Decimal  @db.Decimal(10, 2)
  discountAmount               Decimal  @default(0.00) @db.Decimal(10, 2)
  commissionTypeSnapshot       String
  commissionPercentageSnapshot Decimal  @db.Decimal(5, 2)
  commissionFixedSnapshot      Decimal  @db.Decimal(10, 2)
  commissionAmount             Decimal  @db.Decimal(10, 2)
  partnerNetAmount             Decimal  @db.Decimal(10, 2)
  confirmedBy                  String
  confirmedAt                  DateTime @default(now())
  status                       String   @default("CONFIRMED") // CONFIRMED, DISPUTED, CANCELLED
  // Em que fechamento esta conversão entrou. Sem isto, gerar o fechamento duas
  // vezes contaria a mesma comissão de novo.
  settlementId                 String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  referral   Referral              @relation(fields: [referralId], references: [id], onDelete: Cascade)
  settlement CommissionSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([referralId])
  @@index([settlementId])
  @@map("referral_conversions")
}

model CommissionSettlement {
  id               String           @id @default(cuid())
  // O fechamento só guardava `partnerId`: a listagem do painel mostrava
  // fechamento de qualquer organização para o admin de qualquer uma.
  tenantId         String?
  partnerId        String
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal          @db.Decimal(10, 2)
  commissionAmount Decimal          @db.Decimal(10, 2)
  netAmount        Decimal          @db.Decimal(10, 2)
  status           SettlementStatus @default(OPEN)
  dueDate          DateTime
  paidAt           DateTime?
  paymentReference String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  partner     Partner              @relation(fields: [partnerId], references: [id])
  conversions ReferralConversion[]

  @@index([partnerId, status])
  @@index([tenantId, status])
  @@map("commission_settlements")
}

model PartnerReview {
  id         String   @id @default(cuid())
  referralId String
  tutorId    String
  partnerId  String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id])
  partner  Partner  @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("partner_reviews")
}

model PartnerUser {
  id            String    @id @default(cuid())
  userId        String
  partnerId     String
  partnerUnitId String?
  role          String    @default("STAFF") // OWNER, MANAGER, STAFF
  active        Boolean   @default(true)
  invitedAt     DateTime  @default(now())
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  partner Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  unit    PartnerUnit? @relation(fields: [partnerUnitId], references: [id], onDelete: SetNull)

  @@index([userId, partnerId])
  @@map("partner_users")
}

model ReferralDocument {
  id           String   @id @default(cuid())
  referralId   String
  documentType String   @default("VOUCHER") // VOUCHER, RECEIPT, EXAM_RESULT
  fileUrl      String
  originalName String
  mimeType     String
  fileSize     Int
  uploadedBy   String
  createdAt    DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@map("referral_documents")
}

// ═══════════════════════════════════════════════════════
// ENGINE FINANCEIRO, PAYMENT GATEWAY & SPLIT (ASAAS)
// ═══════════════════════════════════════════════════════

enum StatusPagamento {
  CREATED
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGEBACK
  DISPUTED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

model Payment {
  id                     String          @id @default(uuid())
  tenant_id              String
  atendimento_id         String?
  // Cobrança de assinatura (plano do tutor / clube do veterinário). O webhook
  // usa este campo para saber qual assinatura ativar quando o dinheiro entra.
  assinatura_id          String?
  // Compra no Saúde Pet Mercado. O webhook usa este campo para marcar o pedido
  // como pago e liberar a separação na loja — o mesmo papel que
  // `atendimento_id` faz para a consulta.
  pedido_mercado_id      String?
  // Desconto do plano do tutor. `preco_cheio` guarda o valor de tabela: o
  // repasse do veterinário é calculado sobre ele, e o desconto sai da comissão
  // da plataforma — quem vende o plano é quem banca o benefício.
  preco_cheio            Decimal?        @db.Decimal(10, 2)
  desconto_valor         Decimal         @default(0) @db.Decimal(10, 2)
  desconto_assinatura_id String?
  tutor_id               String
  veterinario_id         String?
  provider               String          @default("asaas") // 'asaas', 'pagar_me', 'mercado_pago'
  external_payment_id    String?         @unique
  idempotency_key        String?         @unique
  method                 PaymentMethod   @default(PIX)
  amount                 Decimal         @db.Decimal(10, 2)
  currency               String          @default("BRL")
  status                 StatusPagamento @default(CREATED)

  // Dados Específicos do PIX
  pix_copy_paste  String?
  pix_qr_code_ref String?

  // Dados Cartão Tokenizado
  card_last_four String?
  card_brand     String?
  installments   Int?    @default(1)

  // Carimbos de Data/Hora
  expires_at    DateTime?
  paid_at       DateTime?
  cancelled_at  DateTime?
  refunded_at   DateTime?
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  // Relações
  veterinario Veterinario?   @relation("VeterinarioPayments", fields: [veterinario_id], references: [id], onDelete: SetNull)
  splits      PaymentSplit[]
  refunds     Refund[]

  @@index([tenant_id])
  @@index([tutor_id])
  @@index([veterinario_id])
  @@index([atendimento_id])
  @@index([assinatura_id])
  @@index([desconto_assinatura_id])
  @@index([pedido_mercado_id])
  @@index([status])
  @@index([external_payment_id])
  @@map("payments")
}

model PaymentSplit {
  id                    String   @id @default(uuid())
  payment_id            String
  recipient_type        String // 'PLATFORM', 'VETERINARIAN', 'PARTNER'
  recipient_id          String?
  provider_recipient_id String? // Wallet ID / Account ID no Asaas
  gross_amount          Decimal  @db.Decimal(10, 2)
  gateway_fee           Decimal  @default(0) @db.Decimal(10, 2)
  platform_fee          Decimal  @default(0) @db.Decimal(10, 2)
  recipient_amount      Decimal  @db.Decimal(10, 2)
  status                String   @default("PENDING") // PENDING, PAID, REFUNDED
  criado_em             DateTime @default(now())
  atualizado_em         DateTime @updatedAt

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([recipient_id])
  @@map("payment_splits")
}

model PaymentEvent {
  id                String    @id @default(uuid())
  provider          String // 'asaas'
  external_event_id String    @unique
  event_type        String // 'PAYMENT_RECEIVED', 'PAYMENT_OVERDUE', etc.
  payload_hash      String
  payload           Json
  processing_status String    @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts          Int       @default(0)
  last_error        String?
  received_at       DateTime  @default(now())
  processed_at      DateTime?

  @@index([provider, external_event_id])
  @@index([processing_status])
  @@map("payment_events")
}

model Refund {
  id                 String    @id @default(uuid())
  payment_id         String
  external_refund_id String?   @unique
  amount             Decimal   @db.Decimal(10, 2)
  reason             String?
  requested_by       String? // ID do Usuário/Admin que solicitou
  status             String    @default("PENDING") // PENDING, COMPLETED, FAILED
  criado_em          DateTime  @default(now())
  completed_at       DateTime?

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@map("refunds")
}

// ═══════════════════════════════════════════════════════
// AGENDAMENTO FUTURO & GRADE DE HORÁRIOS DOS VETERINÁRIOS
// ═══════════════════════════════════════════════════════

model AgendaDisponivel {
  id             String   @id @default(uuid())
  tenant_id      String
  veterinario_id String
  dia_semana     Int // 0 (domingo) a 6 (sábado)
  hora_inicio    String // "08:00"
  hora_fim       String // "18:00"
  ativo          Boolean  @default(true)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  veterinario Veterinario @relation(fields: [veterinario_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, veterinario_id, dia_semana])
  @@map("agendas_disponiveis")
}

// A consulta marcada para uma data futura. `AgendaDisponivel` acima é só o
// molde semanal ("atendo terça das 8h às 18h"); é este modelo que representa
// um horário realmente reservado com tutor e pet.
//
// Vive separado de `Solicitacao` de propósito: a solicitação é o chamado
// imediato, nasce em `procurando_veterinario` e vale para o primeiro vet que
// aceitar. Um agendamento nasce já com dono, e só vira `Solicitacao` quando a
// hora chega — daí `solicitacao_id`, preenchido na conversão.
model Agendamento {
  id                    String            @id @default(uuid())
  tenant_id             String
  veterinario_id        String
  tutor_id              String
  pet_id                String
  // Instante único em UTC. A grade guarda "08:00" como texto porque descreve
  // um molde que se repete toda semana; um compromisso real precisa de data.
  inicio                DateTime
  fim                   DateTime
  tipo_atendimento      TipoAtendimento
  status                StatusAgendamento @default(pendente)
  observacoes           String?
  /// Snapshot do preço próprio publicado pelo veterinário no momento em que
  /// o tutor marcou. Mudanças futuras no catálogo não reescrevem o combinado.
  valor_estimado        Decimal?          @db.Decimal(10, 2)
  preco_catalogo_codigo String?           @db.VarChar(80)
  motivo_cancelamento   String?
  cancelado_por_id      String?
  // Preenchido quando o agendamento vira atendimento de verdade.
  solicitacao_id        String?           @unique
  criado_por_id         String // quem marcou: o tutor ou o próprio vet
  lembrete_enviado      Boolean           @default(false)
  criado_em             DateTime          @default(now())
  atualizado_em         DateTime          @updatedAt

  veterinario Veterinario  @relation(fields: [veterinario_id], references: [id], onDelete: Cascade)
  tutor       Usuario      @relation("TutorAgendamentos", fields: [tutor_id], references: [id], onDelete: Cascade)
  pet         Pet          @relation(fields: [pet_id], references: [id], onDelete: Cascade)
  solicitacao Solicitacao? @relation(fields: [solicitacao_id], references: [id])

  // O índice que sustenta a checagem de conflito de horário.
  @@index([tenant_id, veterinario_id, inicio])
  @@index([tenant_id, tutor_id])
  @@index([status, inicio])
  @@map("agendamentos")
}

// ═══════════════════════════════════════════════════════
// CRM DO VETERINÁRIO — CLIENTELA, NOTAS E RETENÇÃO
// ═══════════════════════════════════════════════════════

// A ficha comercial que o veterinário mantém sobre um tutor que ele atendeu.
//
// Modelo híbrido, decidido em 2026-08-16: o histórico CLÍNICO continua
// compartilhado dentro do tenant (é o que sustenta a continuidade do
// tratamento quando quem atende hoje não é quem atendeu da última vez), mas a
// leitura COMERCIAL — nota privada, tag, apelido, follow-up — é de cada
// veterinário. Por isso a chave é (veterinario_id + tutor_id), e não só
// tutor_id: dois vets do mesmo tenant mantêm fichas independentes do mesmo
// tutor, e nenhum enxerga a anotação do outro.
model ClienteVeterinario {
  id             String @id @default(uuid())
  tenant_id      String
  veterinario_id String
  tutor_id       String

  // Notas privadas do vet sobre o cliente. Nunca entram em PDF, e-mail ou
  // qualquer tela do tutor — ao contrário de `ProntuarioEletronico.orientacoes_tutor`.
  notas_privadas String?
  tags           String[] @default([])
  apelido        String? // como o vet se refere ao cliente
  favorito       Boolean  @default(false)

  // Denormalizado a partir dos atendimentos, para a lista carregar sem varrer
  // o histórico inteiro a cada abertura. Recalculado no fechamento.
  total_atendimentos Int       @default(0)
  ultimo_atendimento DateTime?
  valor_total        Decimal   @default(0) @db.Decimal(10, 2)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  veterinario Veterinario @relation(fields: [veterinario_id], references: [id], onDelete: Cascade)
  tutor       Usuario     @relation("ClientesDoVeterinario", fields: [tutor_id], references: [id], onDelete: Cascade)

  @@unique([veterinario_id, tutor_id])
  @@index([tenant_id, veterinario_id])
  @@index([tenant_id, veterinario_id, ultimo_atendimento])
  @@map("clientes_veterinario")
}

enum StatusAgendamento {
  pendente // marcado, aguardando confirmação do vet
  confirmado
  cancelado
  concluido // virou atendimento
  nao_compareceu
}

// ═══════════════════════════════════════════════════════
// GESTÃO DINÂMICA DE CIDADES, PREÇOS E COBERTURA (ADMIN)
// ═══════════════════════════════════════════════════════

// Inscrição Web Push de um navegador/dispositivo. O endpoint é único por
// definição do protocolo e serve de chave idempotente; inscrição morta
// (410/404 no envio) é apagada pelo push.service.
model PushSubscription {
  id         String   @id @default(uuid())
  tenant_id  String
  usuario_id String
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  criado_em  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, usuario_id])
  @@map("push_subscriptions")
}

/// Histórico do que foi avisado a uma pessoa.
///
/// Até 31/08/2026 a "central de notificações" era um array escrito à mão no
/// frontend, com quatro itens de exemplo iguais para todo mundo. O produto
/// já disparava push nos momentos certos, mas nada disso ficava: quem não
/// estava com o celular na mão no segundo exato perdia o aviso para sempre.
///
/// A linha nasce no mesmo funil que envia o push (`push.service`), então o
/// histórico é o que REALMENTE foi avisado, e não uma segunda lista que
/// alguém precisa lembrar de alimentar. Ela é gravada mesmo quando não há
/// push para entregar — sem inscrição, com a permissão bloqueada ou com o
/// VAPID ausente —, que é justamente quando a pessoa mais precisa achar o
/// aviso depois.
model Notificacao {
  id         String   @id @default(uuid())
  tenant_id  String
  usuario_id String

  titulo    String
  mensagem  String
  /// Rota interna para onde o aviso leva. Nula quando não há o que abrir.
  link      String?
  /// Nome do ícone do AppKit.
  icone     String  @default("bell")
  urgente   Boolean @default(false)

  lida      Boolean   @default(false)
  lida_em   DateTime?
  criado_em DateTime  @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  /// A consulta da tela é sempre "as minhas, mais novas primeiro".
  @@index([tenant_id, usuario_id, criado_em(sort: Desc)])
  /// E o contador do sino é "as minhas não lidas".
  @@index([usuario_id, lida])
  @@map("notificacoes")
}

model CidadeCobertura {
  id                    String   @id @default(uuid())
  tenant_id             String
  nome                  String // "São Paulo", "Campinas", etc.
  estado                String // "SP", "RJ", etc.
  raio_atendimento_km   Int      @default(20)
  preco_emergencia      Decimal  @default(150.00) @db.Decimal(10, 2)
  preco_domiciliar      Decimal  @default(150.00) @db.Decimal(10, 2)
  preco_teleorientacao  Decimal  @default(80.00) @db.Decimal(10, 2)
  /// Aplicação em domicílio: o valor da vacina em si varia por marca e entra na
  /// cobrança à parte, quando houver.
  preco_vacinacao       Decimal  @default(120.00) @db.Decimal(10, 2)
  /// Avaliação clínica sem urgência — mais curta que a consulta completa.
  preco_avaliacao       Decimal  @default(120.00) @db.Decimal(10, 2)
  /// Preventiva, marcada com antecedência: é a mais barata porque o
  /// profissional organiza o deslocamento com folga.
  preco_consulta_rotina Decimal  @default(130.00) @db.Decimal(10, 2)
  /// Quanto a plataforma retém de cada atendimento desta cidade. Era constante
  /// no código (15%) enquanto o plano do produto diz 20 — e mudar comissão não
  /// pode exigir deploy.
  percentual_plataforma Int      @default(20)
  ativo                 Boolean  @default(true)
  criado_em             DateTime @default(now())
  atualizado_em         DateTime @updatedAt

  @@unique([tenant_id, nome, estado])
  @@index([tenant_id, ativo])
  @@map("cidades_cobertura")
}

// ═══════════════════════════════════════════════════════
// SISTEMA DE AUDITORIA FORENSE E IMUTÁVEL (APPEND-ONLY)
// ═══════════════════════════════════════════════════════

/// Leitura da coleira pelo QR público.
///
/// O botão "Achei este Pet! Alertar Tutor" era só um deeplink de WhatsApp: o
/// sistema nunca ficava sabendo que a coleira tinha sido lida, e o tutor de um
/// animal perdido não tinha nenhum sinal de que ele havia sido visto.
model PetTagScan {
  id         String   @id @default(uuid())
  tenant_id  String?
  pet_id     String
  latitude   Float?
  longitude  Float?
  mensagem   String?
  contato    String?
  ip         String?
  user_agent String?
  /// Abertura da página (passiva) x toque em "Achei este pet" (deliberado).
  deliberado Boolean  @default(false)
  criado_em  DateTime @default(now())

  pet Pet @relation(fields: [pet_id], references: [id], onDelete: Cascade)

  @@index([pet_id, criado_em])
  @@index([tenant_id])
  @@map("pet_tag_scans")
}

/// Endereço salvo do tutor, com coordenada já confirmada uma vez.
///
/// Escolher o local do zero a cada chamado é atrito no pior momento possível:
/// o pet passando mal e a pessoa procurando a própria casa no mapa.
model EnderecoTutor {
  id            String    @id @default(uuid())
  tenant_id     String
  tutor_id      String
  rotulo        String
  endereco      String
  complemento   String?
  cidade        String?
  latitude      Float
  longitude     Float
  principal     Boolean   @default(false)
  /// Última vez que este endereço foi usado num chamado — ordena a lista pelo
  /// que a pessoa realmente usa.
  usado_em      DateTime?
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  tutor Usuario @relation(fields: [tutor_id], references: [id], onDelete: Cascade)

  @@index([tutor_id])
  @@index([tenant_id])
  @@map("enderecos_tutor")
}

// ═══════════════════════════════════════════════════════
// SAÚDE PET MERCADO — loja, catálogo, carrinho e pedido
// ═══════════════════════════════════════════════════════
//
// O terceiro módulo do briefing. A diferença para tudo que existe aqui é que o
// vendedor não é a plataforma: é uma empresa de fora — petshop, agropecuária,
// distribuidora — que cadastra a própria loja, o próprio catálogo e recebe o
// próprio repasse. Por isso a loja tem status de aprovação como o veterinário
// tem: quem vende medicamento para animal doente passa por conferência antes
// de aparecer na vitrine.
//
// Esta primeira fatia entrega da vitrine ao pagamento. A entrega por
// ENTREGADOR ainda não existe — `EntregaMercado` já reserva o valor, mas o
// pedido desta fatia só sai por retirada no balcão ou combinação direta com a
// loja. Prometer entrega em tela sem ter quem entregue seria vender o que não
// se tem.

enum StatusLojaMercado {
  rascunho // A empresa começou o cadastro e ainda não enviou
  pendente // Enviada, esperando conferência da equipe
  aprovada
  suspensa
  recusada
}

enum StatusPedidoMercado {
  aguardando_pagamento
  pagamento_falhou
  pago
  em_separacao
  pronto // Separado, esperando o tutor buscar / a loja combinar a entrega
  concluido
  cancelado
  reembolsado
}

enum EntregaMercado {
  retirada // Tutor busca no balcão
  combinar // Loja combina a entrega direto com o tutor
  entregador // Reservado para a fatia da logística; nada emite este valor ainda
  loja // A própria loja leva, dentro do raio dela, com frete calculado pela plataforma
  transportadora // PAC, SEDEX, Jadlog ou Loggi cotados e emitidos pela CepCerto
}

model LojaMercado {
  id             String  @id @default(uuid())
  tenant_id      String
  /// Quem responde pela loja — a conta que administra catálogo e pedidos.
  responsavel_id String
  nome_fantasia  String
  razao_social   String?
  cnpj           String?
  slug           String
  descricao      String?
  logo_url       String?
  email          String
  telefone       String
  whatsapp       String?

  // Onde o tutor busca o pedido. Endereço é obrigatório mesmo na fatia sem
  // entregador: sem ele, "retirada no balcão" não diz em que balcão.
  cep         String?
  endereco    String
  numero      String?
  complemento String?
  bairro      String?
  cidade      String
  estado      String
  latitude    Float?
  longitude   Float?

  status        StatusLojaMercado @default(rascunho)
  motivo_recusa String?
  enviada_em    DateTime?
  aprovada_em   DateTime?
  aprovada_por  String?

  /// Loja de demonstração: criada por seed para testar o Mercado, nunca por
  /// um lojista. O portão é estrutural porque em 01/09/2026 a BioVet (seed)
  /// foi aprovada no painel e apareceu na vitrine, no sitemap e no feed do
  /// Google como se existisse. Com o campo, toda leitura pública exclui a
  /// loja e a aprovação recusa, independente de quem clique onde.
  demonstracao Boolean @default(false)

  /// Comissão da plataforma sobre o pedido. Nulo usa a do tenant
  /// (`configuracoes_tenant.comissao_plataforma_pct`) — a loja só ganha número
  /// próprio quando alguém negocia um.
  comissao_pct Decimal? @db.Decimal(5, 2)

  /// Identificador do recebedor no gateway. Enquanto for nulo, o dinheiro fica
  /// retido na plataforma e o repasse sai por Pix, como já acontece com o
  /// veterinário sem subconta.
  gateway_recebedor_id String?

  aceita_retirada   Boolean @default(true)
  aceita_combinar   Boolean @default(true)
  prazo_preparo_min Int     @default(60)
  pedido_minimo     Decimal @default(0) @db.Decimal(10, 2)

  // ── Entrega pela própria loja (segunda fatia, 27/08/2026).
  //
  // Ração pesada só fecha conta em raio curto. O raio, o frete e o piso do
  // frete grátis são DA LOJA; a plataforma faz a conta pela distância entre a
  // coordenada da loja e a do endereço do tutor, e recusa o que está fora.
  // Sem coordenada da loja não há entrega — é a validação, não a tela, que
  // impede a promessa vazia.
  aceita_entrega      Boolean  @default(false)
  /// Até onde a loja leva, em km. Nulo enquanto a loja não definir.
  entrega_raio_km     Decimal? @db.Decimal(5, 1)
  /// Parcela fixa do frete, cobrada em toda entrega.
  frete_base          Decimal  @default(0) @db.Decimal(10, 2)
  /// Parcela por km rodado, sobre a distância em linha reta.
  frete_por_km        Decimal  @default(0) @db.Decimal(10, 2)
  /// Subtotal a partir do qual o frete é zero. Nulo = nunca é grátis.
  frete_gratis_acima  Decimal? @db.Decimal(10, 2)
  /// Prazo que a loja promete para entregar, em horas. Só informação na tela.
  entrega_prazo_horas Int?

  // Envio nacional pela CepCerto. A loja só ativa quando o CEP de origem e a
  // caixa padrão estão completos; produto sem peso continua indisponível para
  // transportadora, porque estimar peso escondido cobraria frete errado.
  aceita_transportadora Boolean @default(false)

  // ── Assinatura de ração com entrega programada (terceira fatia) ─────────────
  //
  // É a loja quem decide se vende por assinatura e quanto abre mão por isso:
  // o desconto é o preço da recorrência (o tutor deixa de comparar a cada
  // saco) e o frete grátis, quando ela entrega, é o que faz a conta fechar
  // para ração pesada. Ambos ficam CONGELADOS na assinatura no ato de assinar:
  // mudar a política amanhã vale para quem assinar amanhã.
  aceita_assinatura        Boolean  @default(false)
  assinatura_desconto_pct  Decimal  @default(5) @db.Decimal(5, 2)
  assinatura_frete_gratis  Boolean  @default(false)
  embalagem_altura_cm      Decimal? @db.Decimal(5, 1)
  embalagem_largura_cm     Decimal? @db.Decimal(5, 1)
  embalagem_comprimento_cm Decimal? @db.Decimal(5, 1)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  responsavel Usuario             @relation("LojasDoResponsavel", fields: [responsavel_id], references: [id], onDelete: Cascade)
  produtos    ProdutoMercado[]
  carrinhos   CarrinhoMercado[]
  pedidos     PedidoMercado[]
  assinaturas AssinaturaMercado[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, status])
  @@index([responsavel_id])
  @@index([cidade])
  @@map("mercado_lojas")
}

/// Prateleira da vitrine. Curada pela plataforma, não pela loja: se cada
/// vendedor inventasse a própria categoria, a busca do tutor viraria um
/// amontoado de sinônimos.
model CategoriaMercado {
  id                String   @id @default(uuid())
  tenant_id         String
  nome              String
  slug              String
  icone             String?
  ordem             Int      @default(0)
  ativo             Boolean  @default(true)
  /// Margem que o produto desta prateleira herda quando não tem a própria.
  /// 0.25 = 25%. Ração premium suporta 18–30%; acessório e cosmético, bem mais
  /// — decisão comercial de 27/08/2026, no lugar do 40% fixo.
  margem_padrao_pct Decimal? @db.Decimal(5, 4)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  produtos ProdutoMercado[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, ativo])
  @@map("mercado_categorias")
}

model ProdutoMercado {
  id           String  @id @default(uuid())
  tenant_id    String
  loja_id      String
  categoria_id String?

  nome      String
  slug      String
  descricao String?
  marca     String?
  sku       String?
  /// Código de barras. É ele que evita o mesmo produto entrar duas vezes quando
  /// um segundo fornecedor subir o catálogo dele — o nome muda de loja para
  /// loja, o EAN não.
  ean       String?
  /// Sabor, público ou linha: "Frango e arroz - porte pequeno". Fica separado do
  /// nome para virar filtro depois sem ter de quebrar texto.
  variacao  String?
  /// Como a embalagem se apresenta na prateleira: "15 kg", "500 g", "P". É
  /// texto porque nem tudo é peso — coleira tem tamanho, roupa tem numeração.
  tamanho   String?

  // ── Economia da loja. Nada aqui aparece para o tutor: a seleção de campos
  // públicos do catálogo não inclui nenhum destes três.
  /// Quanto a loja paga ao fornecedor.
  custo      Decimal? @db.Decimal(10, 2)
  /// Margem aplicada sobre o custo para chegar ao preço. 0.40 = 40%.
  margem_pct Decimal? @db.Decimal(5, 4)
  /// De quem a loja compra. Permite ranquear margem por fornecedor depois.
  fornecedor String?

  preco             Decimal  @db.Decimal(10, 2)
  /// Preço promocional vigente. Quando preenchido e menor que `preco`, é ele
  /// que o tutor paga — e a tela mostra o de tabela riscado ao lado.
  preco_promocional Decimal? @db.Decimal(10, 2)

  unidade     String @default("un")
  /// Peso bruto, para o cálculo de frete e para a logística de retirada: saco
  /// de 15 kg não sai na mochila de ninguém.
  peso_gramas Int?
  estoque     Int    @default(0)

  /// A loja faz contagem deste item?
  ///
  /// Petshop de bairro em geral NÃO faz — vende enquanto tem e confere na hora
  /// de separar. Forçar contagem nesse caso produziria a pior das mentiras:
  /// prateleira cheia aparecendo como "esgotado" porque ninguém digitou número
  /// nenhum. Com `false`, o item vende sem reservar estoque e a loja confirma
  /// na separação; com `true`, cada pedido baixa a quantidade e o último item
  /// só é vendido uma vez.
  controla_estoque Boolean @default(true)

  /// Vendido a peso, tirado do fardo na hora. Não tem embalagem lacrada nem
  /// código de barras, e a quantidade é em quilos.
  granel               Boolean @default(false)
  /// A loja não mantém em estoque: pede ao fornecedor quando alguém compra.
  /// Sem o prazo à vista, o tutor descobre a espera depois de pagar.
  sob_encomenda        Boolean @default(false)
  prazo_reposicao_dias Int?

  /// Pendência do levantamento ("CONFIRMAR peso", "conferir sabor"). É recado
  /// entre a loja e quem cadastrou — nunca chega ao tutor.
  nota_interna String?

  /// Medicamento de uso veterinário sob prescrição. O pedido com item assim
  /// nasce marcado e a loja é obrigada a conferir a receita antes de separar —
  /// vender antimicrobiano sem receita é infração, não detalhe de produto.
  exige_receita Boolean @default(false)
  /// 'cao', 'gato', 'ambos' ou nulo quando não se aplica (higiene, acessório).
  especie_alvo  String?

  imagem_url String?
  /// Texto alternativo da capa: vai no `alt` do <img> e no JSON-LD. Sem ele a
  /// vitrine usa o nome completo do produto.
  imagem_alt String?
  /// 'aprovada' (vitrine), 'revisar' (fila de QA) ou 'rejeitada'. Nulo sem capa.
  imagem_status String?
  /// A etiqueta de preço do balcão aparece na foto: publicável, mas na fila de troca.
  imagem_tem_etiqueta Boolean @default(false)
  /// Fotos adicionais, em ordem de exibição.
  imagens    Json?

  ativo Boolean @default(true)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  loja            LojaMercado             @relation(fields: [loja_id], references: [id], onDelete: Cascade)
  categoria       CategoriaMercado?       @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  itens           ItemCarrinhoMercado[]
  assinaturaItens ItemAssinaturaMercado[]

  @@unique([loja_id, slug])
  @@index([tenant_id, ativo])
  @@index([loja_id, ativo])
  @@index([categoria_id])
  @@index([ean])
  @@map("mercado_produtos")
}

/// Um carrinho POR LOJA, e não um só com tudo dentro.
///
/// Cada loja separa, embala e entrega o que é dela; um carrinho único com itens
/// de três vendedores viraria três pedidos, três repasses e três prazos escondidos
/// atrás de um botão só. Aqui o tutor pode ter carrinho aberto em várias lojas
/// ao mesmo tempo, e paga um de cada vez — o que ele vê na tela é o que acontece
/// no balcão.
model CarrinhoMercado {
  id        String @id @default(uuid())
  tenant_id String
  tutor_id  String
  loja_id   String

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  tutor Usuario               @relation("CarrinhosDoTutor", fields: [tutor_id], references: [id], onDelete: Cascade)
  loja  LojaMercado           @relation(fields: [loja_id], references: [id], onDelete: Cascade)
  itens ItemCarrinhoMercado[]

  @@unique([tutor_id, loja_id])
  @@index([tenant_id])
  @@map("mercado_carrinhos")
}

/// O item guarda só a quantidade. O preço é lido do produto na hora de mostrar
/// e de fechar: congelar preço no carrinho faria o tutor pagar um valor que a
/// loja já mudou, e descongelar sem avisar seria pior.
model ItemCarrinhoMercado {
  id          String @id @default(uuid())
  carrinho_id String
  produto_id  String
  quantidade  Int    @default(1)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  carrinho CarrinhoMercado @relation(fields: [carrinho_id], references: [id], onDelete: Cascade)
  produto  ProdutoMercado  @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@unique([carrinho_id, produto_id])
  @@index([produto_id])
  @@map("mercado_carrinho_itens")
}

model PedidoMercado {
  id        String @id @default(uuid())
  tenant_id String
  loja_id   String
  tutor_id  String
  /// Código curto para o balcão. Ninguém dita um UUID no telefone.
  codigo    String @unique

  status       StatusPedidoMercado @default(aguardando_pagamento)
  entrega_tipo EntregaMercado      @default(retirada)

  // Endereço só existe quando a loja vai levar. Guardado como cópia: mudar o
  // endereço salvo depois não pode reescrever para onde um pedido antigo foi.
  entrega_endereco     String?
  entrega_cep          String?
  entrega_numero       String?
  entrega_complemento  String?
  entrega_cidade       String?
  entrega_latitude     Float?
  entrega_longitude    Float?
  /// Distância cobrada quando a própria loja entrega. Guardada, não
  /// recalculada: a loja pode mudar o raio amanhã, e o frete pago hoje precisa
  /// continuar explicável.
  entrega_distancia_km Decimal? @db.Decimal(6, 2)

  // Fotografia da cotação CepCerto escolhida. Peso e medidas ficam no pedido:
  // editar o catálogo ou a caixa padrão amanhã não muda a postagem já vendida.
  frete_servico        String?
  frete_transportadora String?
  frete_prazo          String?
  frete_peso_gramas    Int?
  frete_altura_cm      Decimal?  @db.Decimal(5, 1)
  frete_largura_cm     Decimal?  @db.Decimal(5, 1)
  frete_comprimento_cm Decimal?  @db.Decimal(5, 1)
  rastreio_codigo      String?
  etiqueta_url         String?
  declaracao_url       String?
  etiqueta_emitida_em  DateTime?

  subtotal Decimal @db.Decimal(10, 2)
  desconto Decimal @default(0) @db.Decimal(10, 2)
  frete    Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  comissao_pct   Decimal @db.Decimal(5, 2)
  comissao_valor Decimal @db.Decimal(10, 2)
  repasse_loja   Decimal @db.Decimal(10, 2)

  /// Cobrança em `payments`. O webhook do gateway usa o caminho inverso
  /// (`payments.pedido_mercado_id`) para marcar o pedido como pago.
  payment_id String?

  /// Pedido gerado por um ciclo de assinatura. Nulo na compra avulsa.
  assinatura_id String?

  /// Algum item exige receita. Copiado para o pedido para a loja ver na fila,
  /// sem precisar abrir item por item.
  exige_receita Boolean @default(false)

  observacao       String?
  cancelado_motivo String?
  cancelado_por    String?

  /// Prazo da cobrança. Passou disto sem pagar, o estoque volta para a prateleira.
  expira_em     DateTime?
  pago_em       DateTime?
  separado_em   DateTime?
  pronto_em     DateTime?
  concluido_em  DateTime?
  cancelado_em  DateTime?
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  loja       LojaMercado           @relation(fields: [loja_id], references: [id], onDelete: Restrict)
  tutor      Usuario               @relation("PedidosDoTutor", fields: [tutor_id], references: [id], onDelete: Restrict)
  assinatura AssinaturaMercado?    @relation(fields: [assinatura_id], references: [id], onDelete: SetNull)
  itens      ItemPedidoMercado[]
  eventos    EventoPedidoMercado[]

  @@index([tenant_id, status])
  @@index([loja_id, status])
  @@index([tutor_id])
  @@index([payment_id])
  @@index([assinatura_id])
  @@map("mercado_pedidos")
}

/// Cópia do produto no instante da compra. O catálogo muda todo dia; a nota do
/// que foi vendido, não.
model ItemPedidoMercado {
  id         String  @id @default(uuid())
  pedido_id  String
  produto_id String?

  nome                 String
  sku                  String?
  /// Sabor ou linha, como estava na hora da compra.
  variacao             String?
  unidade              String  @default("un")
  preco_unitario       Decimal @db.Decimal(10, 2)
  quantidade           Int
  subtotal             Decimal @db.Decimal(10, 2)
  exige_receita        Boolean @default(false)
  /// Prazo prometido quando o item era sob encomenda. Fica no item, e não no
  /// produto, porque é a promessa feita NAQUELA compra — mudar o cadastro
  /// depois não pode reescrever o que o tutor leu antes de pagar.
  prazo_encomenda_dias Int?
  /// Peso congelado para a declaração e o pacote da transportadora.
  peso_gramas          Int?

  criado_em DateTime @default(now())

  pedido PedidoMercado @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@index([pedido_id])
  @@index([produto_id])
  @@map("mercado_pedido_itens")
}

/// Linha do tempo do pedido, no mesmo espírito de `solicitacoes_timeline`:
/// quem mudou, de que estado para qual, quando e por quê. Só entra, nunca sai.
model EventoPedidoMercado {
  id              String               @id @default(uuid())
  pedido_id       String
  status          StatusPedidoMercado
  status_anterior StatusPedidoMercado?
  ator_id         String?
  ator_papel      String?
  origem          String? // 'tutor', 'loja', 'admin', 'webhook', 'worker'
  motivo          String?
  criado_em       DateTime             @default(now())

  pedido PedidoMercado @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@index([pedido_id])
  @@map("mercado_pedido_eventos")
}

enum StatusAssinaturaMercado {
  ativa
  pausada
  cancelada
}

/// Assinatura de ração com entrega programada (terceira fatia do mercado).
///
/// A recorrência aqui é HONESTA: o ciclo gera um pedido `aguardando_pagamento`
/// e avisa o tutor com o Pix pronto. Não há cobrança automática — o checkout
/// não guarda cartão sem CVV (decisão de 24/08) e o preapproval do Mercado
/// Pago ainda não foi contratado. Quando um dos dois existir, o worker passa
/// a cobrar em vez de lembrar, e o resto continua igual.
model AssinaturaMercado {
  id        String                  @id @default(uuid())
  tenant_id String
  loja_id   String
  tutor_id  String
  pet_id    String?
  status    StatusAssinaturaMercado @default(ativa)

  /// A cada quantos dias nasce um pedido. Sugerido pelo porte do pet e pelo
  /// peso do saco; o tutor pode ajustar.
  frequencia_dias  Int
  proximo_ciclo_em DateTime

  // Como recebe: retirada, combinar ou entrega pela loja. Transportadora fica
  // de fora — cotação por ciclo exigiria CPF e CepCerto a cada geração.
  entrega_tipo        EntregaMercado @default(retirada)
  entrega_endereco    String?
  entrega_cep         String?
  entrega_numero      String?
  entrega_complemento String?
  entrega_cidade      String?
  entrega_latitude    Float?
  entrega_longitude   Float?

  // Política da loja no ato de assinar, congelada.
  desconto_pct Decimal @default(0) @db.Decimal(5, 2)
  frete_gratis Boolean @default(false)

  ciclos_gerados           Int     @default(0)
  ciclos_pagos             Int     @default(0)
  /// Ciclos seguidos que venceram sem pagamento. Três pausam a assinatura:
  /// continuar gerando pedido para quem não paga só prende estoque da loja.
  ciclos_perdidos_seguidos Int     @default(0)
  ultimo_pedido_id         String?
  ultimo_erro              String?

  observacao       String?
  pausada_em       DateTime?
  cancelada_em     DateTime?
  cancelado_motivo String?
  criado_em        DateTime  @default(now())
  atualizado_em    DateTime  @updatedAt

  loja    LojaMercado             @relation(fields: [loja_id], references: [id], onDelete: Restrict)
  tutor   Usuario                 @relation("AssinaturasDoTutor", fields: [tutor_id], references: [id], onDelete: Cascade)
  pet     Pet?                    @relation(fields: [pet_id], references: [id], onDelete: SetNull)
  itens   ItemAssinaturaMercado[]
  pedidos PedidoMercado[]

  @@index([tenant_id, status, proximo_ciclo_em])
  @@index([loja_id, status])
  @@index([tutor_id])
  @@map("mercado_assinaturas")
}

model ItemAssinaturaMercado {
  id            String @id @default(uuid())
  assinatura_id String
  produto_id    String
  quantidade    Int    @default(1)

  criado_em DateTime @default(now())

  assinatura AssinaturaMercado @relation(fields: [assinatura_id], references: [id], onDelete: Cascade)
  produto    ProdutoMercado    @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@unique([assinatura_id, produto_id])
  @@index([produto_id])
  @@map("mercado_assinatura_itens")
}
