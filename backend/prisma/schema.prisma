// Prisma Schema para Saúde Pet

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  tutor
  veterinario
  admin
  super_admin // Admin global que gerencia múltiplos tenants
}

enum StatusAtendimento {
  criado
  procurando_veterinario
  oferta_enviada
  veterinario_encontrado
  aceito
  a_caminho
  chegou
  atendimento_em_andamento
  finalizado
  concluido // Sinônimo de finalizado para compatibilidade
  encaminhado // Emergência clínica: tutor orientado a buscar serviço de emergência
  sem_veterinario
  expirado
  recusado
  cancelado
  cancelado_tutor
  cancelado_vet
  cancelado_admin
  pagamento_falhou
  contestado
}

enum TipoAtendimento {
  emergencia
  consulta_domiciliar
  teleorientacao
  // Os três que o briefing pede e a vitrine não oferecia. Vacinação já tinha
  // lastro clínico (a aplicação é gravada em `pets_vacinas` e alimenta a
  // carteira digital e a tag da coleira); faltava poder pedir.
  vacinacao
  avaliacao
  consulta_rotina
}

enum CategoriaCatalogoVeterinario {
  SERVICO_DOMICILIAR
  VACINA
  OUTRO_SERVICO
  ADICIONAL_HORARIO
}

enum StatusTenant {
  ativo
  suspenso
  trial
  cancelado
}

enum PlanoTenant {
  free
  basic
  premium
  enterprise
}

// ═══════════════════════════════════════════════════════
// MULTI-TENANT
// ═══════════════════════════════════════════════════════

model Tenant {
  id              String       @id @default(uuid())
  nome            String // Nome da clínica/organização
  slug            String       @unique // URL-friendly identifier
  cnpj            String?      @unique
  email           String
  telefone        String
  endereco        String?
  cidade          String
  estado          String
  logo            String?
  plano           PlanoTenant  @default(free)
  status          StatusTenant @default(trial)
  limite_usuarios Int          @default(10)
  limite_pets     Int          @default(100)
  criado_em       DateTime     @default(now())
  atualizado_em   DateTime     @updatedAt
  expira_em       DateTime? // Data de expiração do plano

  // Relações
  usuarios      Usuario[]
  configuracoes ConfiguracaoTenant?

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model ConfiguracaoTenant {
  id                      String   @id @default(uuid())
  tenant_id               String   @unique
  permitir_cadastro       Boolean  @default(true)
  requer_aprovacao_vet    Boolean  @default(true)
  notificacoes_email      Boolean  @default(true)
  notificacoes_sms        Boolean  @default(false)
  cor_primaria            String   @default("#3B82F6")
  cor_secundaria          String   @default("#10B981")
  // Regras comerciais configuráveis pelo painel (antes fixas em código/env)
  comissao_plataforma_pct Decimal  @default(15.00) @db.Decimal(5, 2)
  cidade_padrao           String?
  criado_em               DateTime @default(now())
  atualizado_em           DateTime @updatedAt

  // Relações
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("configuracoes_tenant")
}

// ═══════════════════════════════════════════════════════
// USUÁRIOS E PERFIS
// ═══════════════════════════════════════════════════════

model Usuario {
  id                   String      @id @default(uuid())
  tenant_id            String? // Cada usuário pertence a um tenant
  nome                 String
  email                String
  senha                String? // Opcional para usuários autenticados via OAuth (Google, Apple, etc.)
  senha_hash           String?
  tipo_usuario         TipoUsuario @default(tutor)
  telefone             String?
  cpf                  String?
  /// Pedida pelo briefing no perfil do tutor, e útil na emergência: idade do
  /// responsável muda a orientação que o veterinário dá por telefone.
  data_nascimento      DateTime?
  cep                  String?
  endereco             String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  estado               String?
  avatar               String?
  foto_perfil          String?
  foto_capa            String?
  sobre                String?
  ativo                Boolean     @default(true)
  email_verificado     Boolean     @default(false)
  primeiro_acesso      Boolean     @default(true)
  data_ultimo_acesso   DateTime?
  preferencias         String? // JSON com preferências do usuário
  // Invalidação em massa de sessão: qualquer JWT emitido ANTES desta marca é
  // recusado no authMiddleware. É o que faz "revogar sessões", suspender um
  // veterinário e trocar a senha derrubarem de fato quem já estava logado —
  // antes disso o access token de 7 dias continuava valendo e as três ações
  // eram só aviso na tela.
  /// Reputação do tutor, escrita quando um veterinário o avalia. Fica aqui, e
  /// não calculada na leitura, porque o veterinário precisa dela na FILA de
  /// chamados — calcular por chamado seria uma consulta a mais em cada card.
  avaliacao_media      Float?
  total_avaliacoes     Int         @default(0)
  sessoes_revogadas_em DateTime?
  // Bloqueio aplicado pela moderação. Espelhado aqui (em vez de consultar
  // `Punicao` a cada request) porque o authMiddleware roda em toda chamada:
  // o dado já vem no mesmo `findUnique` que carrega o usuário.
  bloqueado            Boolean     @default(false)
  bloqueado_ate        DateTime? // NULL com bloqueado=true significa permanente
  bloqueio_motivo      String?
  criado_em            DateTime    @default(now())
  atualizado_em        DateTime    @updatedAt

  // Relações
  tenant             Tenant?              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  pets               Pet[]
  veterinario        Veterinario?
  solicitacoes       Solicitacao[]        @relation("TutorSolicitacoes")
  mensagensEnviadas  Mensagem[]           @relation("MensagensEnviadas")
  mensagensRecebidas Mensagem[]           @relation("MensagensRecebidas")
  avaliacoes         Avaliacao[]          @relation("AvaliacoesTutor")
  onboardings        TutorOnboarding[]
  identities         AuthIdentity[]
  exchangeCodes      AuthExchangeCode[]
  agendamentos       Agendamento[]        @relation("TutorAgendamentos")
  fichasDeCliente    ClienteVeterinario[] @relation("ClientesDoVeterinario")
  pushSubscriptions  PushSubscription[]
  notificacoes       Notificacao[]
  enderecos          EnderecoTutor[]
  // Saúde Pet Mercado: a mesma conta que pede atendimento compra no mercado, e
  // pode também RESPONDER por uma loja — o dono do petshop tem cachorro em casa
  // como qualquer pessoa.
  lojasMercado       LojaMercado[]        @relation("LojasDoResponsavel")
  carrinhosMercado   CarrinhoMercado[]    @relation("CarrinhosDoTutor")
  pedidosMercado     PedidoMercado[]      @relation("PedidosDoTutor")
  assinaturasMercado AssinaturaMercado[]  @relation("AssinaturasDoTutor")
  cartoesSalvos      CartaoSalvo[]

  @@unique([tenant_id, email]) // Email único por tenant
  @@index([tenant_id])
  @@index([email])
  @@index([tipo_usuario])
  @@index([bloqueado])
  @@map("usuarios")
}

model AuthIdentity {
  id               String   @id @default(uuid())
  tenant_id        String
  usuario_id       String
  provider         String // "google", "facebook", "apple"
  provider_user_id String // sub
  criado_em        DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, provider, provider_user_id])
  @@index([usuario_id])
  @@index([tenant_id])
  @@map("auth_identities")
}

model AuthExchangeCode {
  id         String    @id @default(uuid())
  tenant_id  String
  code_hash  String    @unique
  usuario_id String
  expires_at DateTime
  used_at    DateTime?
  criado_em  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([code_hash])
  @@index([usuario_id])
  @@map("auth_exchange_codes")
}

model Pet {
  id                      String    @id @default(uuid())
  tenant_id               String // Herdado do tutor
  tutor_id                String
  nome                    String
  tipo                    String?
  especie                 String? // cão, gato, pássaro, etc
  raca                    String?
  idade                   Int?
  sexo                    String? // macho, fêmea
  peso                    Float? // em kg
  data_nascimento         DateTime?
  porte                   String? // pequeno, médio, grande
  cor                     String?
  /// Registro de pedigree, quando o animal tem. O briefing pede, e para quem
  /// cria é dado de identidade tanto quanto o microchip.
  pedigree                String?
  castrado                Boolean   @default(false)
  microchip               String?
  /// O que o animal já tem e não vai embora — cardiopatia, epilepsia, diabetes.
  /// Antes só cabia no texto livre de `observacoes`, onde ninguém consulta e
  /// que a ficha clínica não lê.
  condicoes_preexistentes String?   @db.Text
  rga                     String?
  observacoes             String?
  foto                    String?
  ativo                   Boolean   @default(true)
  criado_em               DateTime  @default(now())
  atualizado_em           DateTime  @default(now()) @updatedAt

  // Relações
  tutor              Usuario                @relation(fields: [tutor_id], references: [id], onDelete: Cascade)
  solicitacoes       Solicitacao[]
  prontuarios        ProntuarioEletronico[]
  vacinas            PetVacina[]
  medicamentos       PetMedicamento[]
  alergias           PetAlergia[]
  lembretes          LembretePet[]
  agendamentos       Agendamento[]
  leiturasDaTag      PetTagScan[]
  assinaturasMercado AssinaturaMercado[]

  @@index([tenant_id])
  @@index([tutor_id])
  @@map("pets")
}

enum StatusCredenciamento {
  DRAFT
  PENDING_DOCUMENTS
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
  REQUIRES_RESUBMISSION
}

enum StatusFinanceiroVet {
  NOT_STARTED
  PENDING_DATA
  PENDING_PROVIDER
  UNDER_REVIEW
  ACTIVE
  RESTRICTED
  REJECTED
  SUSPENDED
}

model Veterinario {
  id                    String               @id @default(uuid())
  tenant_id             String // Herdado do usuário
  usuario_id            String               @unique
  crmv                  String
  /// UF do conselho que emitiu o CRMV ("SP", "MG"). O número sozinho não
  /// identifica o profissional: cada conselho regional tem a própria numeração.
  crmv_uf               String?              @db.VarChar(2)
  especialidade         String
  sobre                 String?
  aprovado_admin        Boolean              @default(false)
  status_credenciamento StatusCredenciamento @default(PENDING_REVIEW)
  motivo_decisao        String?
  observacao_interna    String?
  decidido_por_id       String?
  decidido_em           DateTime?
  /// Até onde este profissional aceita ir. Vazio = usa o raio da cidade.
  ///
  /// Antes o raio era só da cidade, igual para todos: o veterinário que só
  /// atende a zona sul recebia chamado do outro lado, recusava, e o tutor
  /// esperava mais por um "não" previsível.
  raio_atendimento_km   Int?
  /// Onde ele costuma atender, em palavras ("zona sul e centro"). É informação
  /// para o tutor e para o despacho manual — o filtro de verdade é o raio.
  area_atuacao          String?
  online                Boolean              @default(false)
  avaliacao_media       Float                @default(0)
  total_atendimentos    Int                  @default(0)
  latitude              Float?
  longitude             Float?
  ultimo_ping_online    DateTime?
  criado_em             DateTime             @default(now())

  // Onboarding & Carteira Financeira (Asaas / Split)
  status_financeiro   StatusFinanceiroVet @default(NOT_STARTED)
  provider_financeiro String?             @default("asaas")
  asaas_account_id    String?
  asaas_wallet_id     String?
  dados_bancarios     String? // Criptografado JSON
  habilita_split      Boolean             @default(false)
  habilitado_em       DateTime?

  // Documentos profissionais (CRMV/diploma) e verificação por IA
  documento_url            String?
  diploma_url              String?
  documento_identidade_url String?
  documento_analise        Json?
  documento_analisado_em   DateTime?

  // Relações
  usuario        Usuario                   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  atendimentos   Solicitacao[]
  avaliacoes     Avaliacao[]               @relation("AvaliacoesVeterinario")
  agendas        AgendaDisponivel[]
  agendamentos   Agendamento[]
  midias         MidiaAtendimento[]
  clientes       ClienteVeterinario[]
  lembretes      LembretePet[]
  prontuarios    ProntuarioEletronico[]
  submissoes     VeterinarioSubmissao[]
  payments       Payment[]                 @relation("VeterinarioPayments")
  catalogo_itens CatalogoItemVeterinario[]

  @@unique([tenant_id, crmv]) // CRMV único por tenant
  @@index([tenant_id])
  @@index([tenant_id, online])
  @@index([status_credenciamento])
  @@index([status_financeiro])
  @@index([crmv_uf])
  @@map("veterinarios")
}

/// Tabela comercial publicada por cada profissional. A cidade continua
/// definindo o preço de referência da plataforma; esta tabela permite que o
/// tutor compare o valor real de quem escolheu, sem misturar preço com agenda.
model CatalogoItemVeterinario {
  id               String                       @id @default(uuid())
  tenant_id        String
  veterinario_id   String
  codigo           String                       @db.VarChar(80)
  nome             String                       @db.VarChar(120)
  categoria        CategoriaCatalogoVeterinario
  tipo_atendimento TipoAtendimento?
  preco            Decimal?                     @db.Decimal(10, 2)
  ativo            Boolean                      @default(false)
  ordem            Int                          @default(0)
  criado_em        DateTime                     @default(now())
  atualizado_em    DateTime                     @updatedAt

  veterinario Veterinario @relation(fields: [veterinario_id], references: [id], onDelete: Cascade)

  @@unique([veterinario_id, codigo])
  @@index([tenant_id, categoria, ativo])
  @@index([tenant_id, tipo_atendimento, ativo])
  @@map("catalogo_itens_veterinario")
}

model VeterinarioSubmissao {
  id                       String    @id @default(uuid())
  veterinario_id           String
  status                   String
  documento_url            String?
  diploma_url              String?
  documento_identidade_url String?
  documento_analise        Json?
  motivo                   String?
  observacao_admin         String?
  decidido_por_id          String?
  decidido_em              DateTime?
  criado_em                DateTime  @default(now())

  veterinario Veterinario @relation(fields: [veterinario_id], references: [id], onDelete: Cascade)

  @@index([veterinario_id])
  @@map("veterinarios_submissoes")
}

model Solicitacao {
  id                  String            @id @default(uuid())
  tenant_id           String // Herdado do tutor
  tutor_id            String
  veterinario_id      String?
  pet_id              String
  tipo_atendimento    TipoAtendimento
  status              StatusAtendimento @default(procurando_veterinario)
  localizacao_cliente String?
  valor_estimado      Float?
  latitude            Float?
  longitude           Float?
  latitude_vet        Float?
  longitude_vet       Float?
  ultimo_ping_vet     DateTime?
  motivo_cancelamento String?
  diagnostico         String? // Diagnóstico do veterinário
  receita             String? // Receita/prescrição
  // Versão vigente do documento de receita. 1 = original; cada retificação
  // depois do fechamento incrementa e gera um PDF novo, marcado como tal.
  receita_versao      Int               @default(1)
  receita_pdf_url     String? // URL do PDF no R2
  prontuario_pdf_url  String? // URL do Prontuário no R2
  observacoes         String? // Observações adicionais
  criado_em           DateTime          @default(now())
  atualizado_em       DateTime          @updatedAt
  finalizado_em       DateTime?

  // Relações
  tutor               Usuario      @relation("TutorSolicitacoes", fields: [tutor_id], references: [id])
  veterinario         Veterinario? @relation(fields: [veterinario_id], references: [id])
  pet                 Pet          @relation(fields: [pet_id], references: [id])
  /// Quando o pedido de avaliação foi enviado ao tutor. Sem esta marca, o
  /// worker mandaria o mesmo e-mail de hora em hora até ele avaliar — a melhor
  /// forma de ensinar alguém a ignorar as nossas mensagens.
  avaliacao_pedida_em DateTime?

  /// Encaminhamento clínico: o caso excedeu o atendimento domiciliar e o tutor
  /// foi orientado a procurar um serviço de emergência.
  ///
  /// Nasceram porque motivo e orientação eram enfiados dentro de `diagnostico` e
  /// `receita` com o prefixo `[EMERGÊNCIA]` — servia para exibir e não servia
  /// para consultar, contar nem imprimir em seção própria. Pior: a tela do tutor
  /// já lia um campo `orientacao_encaminhamento` que NUNCA existiu, então a
  /// orientação escrita pelo veterinário não chegava a ele.
  encaminhamento_motivo     String?   @db.Text
  encaminhamento_orientacao String?   @db.Text
  encaminhado_em            DateTime?

  /// Duas, agora: a do tutor sobre o veterinário e a do veterinário sobre o tutor.
  avaliacoes     Avaliacao[]
  mensagens      Mensagem[]
  timeline       SolicitacaoTimeline[]
  prontuario     ProntuarioEletronico?
  midiasEnviadas MidiaAtendimento[]
  agendamento    Agendamento?
  retificacoes   ReceitaRetificacao[]
  /// Auditoria da teleorientação. Ver `GravacaoChamada`.
  gravacoes      GravacaoChamada[]

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, tutor_id])
  @@index([tenant_id, veterinario_id])
  @@map("solicitacoes")
}

/// Cartão que o tutor mandou guardar.
///
/// Guardamos REFERÊNCIA, nunca o cartão: o identificador que o gateway devolve,
/// mais o que serve para a pessoa reconhecer qual é (bandeira, quatro últimos
/// dígitos, validade). Número e código de segurança nunca passam pelo nosso
/// servidor — quem os recebe é o SDK do gateway, direto do navegador.
///
/// Existe por um motivo de uso, não de tecnologia: na segunda emergência,
/// digitar o cartão inteiro é atrito no pior momento possível. Com o cartão
/// guardado, o checkout pede só o código de segurança.
model CartaoSalvo {
  id         String @id @default(uuid())
  tenant_id  String
  usuario_id String

  /// `mercadopago` hoje. A coluna existe para o dia em que houver outro.
  gateway     String @default("mercadopago")
  /// Identificadores do gateway. O cartão vive lá, não aqui.
  customer_id String
  card_id     String

  bandeira        String?
  ultimos_digitos String
  validade_mes    Int?
  validade_ano    Int?
  /// Como a pessoa chama ("meu Nubank"). Opcional: os quatro dígitos já
  /// identificam, e obrigar a nomear cartão é burocracia.
  apelido         String?
  principal       Boolean  @default(false)
  criado_em       DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, gateway, card_id])
  @@index([tenant_id])
  @@index([usuario_id])
  @@map("cartoes_salvos")
}

/// Avaliação de um atendimento — nas duas direções.
///
/// O modelo só sabia uma: `tutor_id` era sempre quem avaliava e `veterinario_id`
/// sempre quem era avaliado, com um atendimento comportando uma avaliação só. A
/// confiança bilateral que o produto promete exigia mudar isto, não só criar
/// uma tela: agora `autor_papel` diz quem escreveu, e cada atendimento comporta
/// as duas avaliações — uma de cada lado.
///
/// As colunas continuam nomeando as PESSOAS envolvidas (o tutor e o veterinário
/// do atendimento), não os papéis de autor e avaliado. Quem lê descobre a
/// direção por `autor_papel`.
model Avaliacao {
  id             String   @id @default(uuid())
  tenant_id      String // Herdado do atendimento
  atendimento_id String
  tutor_id       String // O tutor do atendimento
  veterinario_id String // O veterinário do atendimento
  /// tutor = o tutor avaliou o veterinário. veterinario = o contrário.
  autor_papel    String   @default("tutor")
  nota           Int // 1 a 5
  comentario     String?
  criado_em      DateTime @default(now())

  // Relações
  atendimento Solicitacao @relation(fields: [atendimento_id], references: [id], onDelete: Cascade)
  tutor       Usuario     @relation("AvaliacoesTutor", fields: [tutor_id], references: [id])
  veterinario Veterinario @relation("AvaliacoesVeterinario", fields: [veterinario_id], references: [id])

  /// Uma avaliação por lado, por atendimento.
  @@unique([atendimento_id, autor_papel])
  @@index([tenant_id])
  @@index([veterinario_id])
  @@index([tutor_id])
  @@map("avaliacoes")
}

model Mensagem {
  id              String    @id @default(uuid())
  tenant_id       String // Herdado do remetente
  remetente_id    String
  destinatario_id String
  atendimento_id  String?
  // Nulo quando a mensagem é só um anexo ou uma localização.
  conteudo        String?
  lida            Boolean   @default(false)
  arquivada       Boolean   @default(false)
  tipo            String    @default("texto") // texto, imagem, documento, localizacao, video
  metadados       String? // JSON com metadados (tamanho arquivo, etc)
  criado_em       DateTime  @default(now())
  lida_em         DateTime?
  editada_em      DateTime?
  deletada_em     DateTime? // Soft delete: o conteúdo original permanece na linha
  deletada_por_id String?

  // Localização compartilhada como ponto único, não rastreamento ao vivo.
  // Colunas próprias em vez de JSON em `metadados` porque isto é validado na
  // entrada e lido por quem audita o atendimento.
  latitude  Float?
  longitude Float?
  endereco  String?

  // Relações
  remetente    Usuario          @relation("MensagensEnviadas", fields: [remetente_id], references: [id], onDelete: Cascade)
  destinatario Usuario          @relation("MensagensRecebidas", fields: [destinatario_id], references: [id], onDelete: Cascade)
  atendimento  Solicitacao?     @relation(fields: [atendimento_id], references: [id], onDelete: SetNull)
  anexos       MensagemAnexo[]
  edicoes      MensagemEdicao[]

  // Índices otimizados para alto volume
  @@index([tenant_id, criado_em(sort: Desc)]) // Busca por tenant ordenada por data
  @@index([remetente_id, criado_em(sort: Desc)]) // Mensagens enviadas
  @@index([destinatario_id, lida, criado_em(sort: Desc)]) // Mensagens recebidas não lidas
  @@index([atendimento_id, criado_em(sort: Desc)]) // Mensagens de um atendimento
  @@index([tenant_id, remetente_id, destinatario_id]) // Conversas específicas
  @@index([criado_em]) // Queries por período
  @@map("mensagens")
}

/// Arquivo trocado no chat, preso à mensagem que o enviou — e não ao atendimento,
/// para que continue rastreável quem mandou o quê, quando, e em qual conversa.
model MensagemAnexo {
  id          String @id @default(uuid())
  tenant_id   String
  mensagem_id String

  /// Chave do objeto no R2. Guardamos a chave, nunca a URL pública: o acesso ao
  /// arquivo é sempre por URL assinada de curta duração, gerada na leitura.
  storage_key   String
  nome_original String
  mime_type     String
  tamanho_bytes Int
  tipo          String // imagem | documento | video
  criado_em     DateTime @default(now())

  /// Quando o binário saiu do R2 por política de retenção (`ANEXO_RETENCAO_DIAS`).
  /// A linha permanece — a auditoria da conversa é intencional; o que some é só
  /// o arquivo. Preenchido, a API devolve `url: null` e a tela avisa em vez de
  /// tentar exibir uma imagem que não existe mais.
  arquivo_removido_em DateTime?

  mensagem Mensagem @relation(fields: [mensagem_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([mensagem_id])
  @@map("mensagens_anexos")
}

/// Histórico de edição de mensagem. Cada edição arquiva o conteúdo anterior, de
/// modo que a versão original de uma conversa nunca desaparece — é o que torna a
/// auditoria de um atendimento confiável.
model MensagemEdicao {
  id                String   @id @default(uuid())
  tenant_id         String
  mensagem_id       String
  conteudo_anterior String   @db.Text
  editado_por_id    String
  editado_em        DateTime @default(now())

  mensagem Mensagem @relation(fields: [mensagem_id], references: [id], onDelete: Cascade)

  @@index([mensagem_id, editado_em])
  @@map("mensagens_edicoes")
}

model ConfiguracaoNotificacao {
  id                     String   @id @default(uuid())
  notificacao_email      Boolean  @default(true)
  notificacao_popup      Boolean  @default(true)
  notificacao_sms        Boolean  @default(false)
  email_novo_veterinario Boolean  @default(true)
  popup_novo_veterinario Boolean  @default(true)
  sms_novo_veterinario   Boolean  @default(false)
  criado_em              DateTime @default(now())
  atualizado_em          DateTime @updatedAt

  @@map("configuracoes_notificacao")
}

// ═══════════════════════════════════════════════════════
// AUTENTICAÇÃO AVANÇADA
// ═══════════════════════════════════════════════════════

model RefreshToken {
  id         String   @id @default(uuid())
  usuario_id String
  token      String   @unique
  expira_em  DateTime
  criado_em  DateTime @default(now())
  ip         String?
  user_agent String?

  @@index([usuario_id])
  @@index([token])
  @@index([expira_em])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tenant_id String?
  email     String
  token     String   @unique
  expira_em DateTime
  usado     Boolean  @default(false)
  criado_em DateTime @default(now())
  ip        String?

  @@index([email])
  @@index([token])
  @@index([expira_em])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  tenant_id  String?
  email      String
  token      String   @unique
  expira_em  DateTime
  verificado Boolean  @default(false)
  criado_em  DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("email_verification_tokens")
}

model AuditLog {
  id               String   @id @default(uuid())
  tenant_id        String?
  usuario_id       String? // actor_user_id
  actor_role       String? // role do usuario
  acao             String // ex: 'SOLICITACAO_CRIADA', 'PAGAMENTO_CONFIRMADO', etc
  recurso          String? // entity_type
  recurso_id       String? // entity_id
  entity_type      String? // alias explicito para integridade pericial
  entity_id        String? // alias explicito para integridade pericial
  request_id       String? // correlation id HTTP
  ip               String?
  user_agent       String?
  estado_anterior  Json? // snapshot antes
  estado_posterior Json? // snapshot depois
  motivo           String? // justificativa da acao
  detalhes         String? // JSON legilve/extra
  sucesso          Boolean  @default(true)
  erro_mensagem    String?
  criado_em        DateTime @default(now())

  @@index([tenant_id])
  @@index([usuario_id])
  @@index([acao])
  @@index([recurso, recurso_id])
  @@index([criado_em])
  @@map("audit_logs")
}

model TokenBlacklist {
  id         String   @id @default(uuid())
  token      String   @unique
  usuario_id String
  motivo     String // 'logout', 'force_logout', 'password_changed'
  expira_em  DateTime
  criado_em  DateTime @default(now())

  @@index([token])
  @@index([expira_em])
  @@map("token_blacklist")
}

// ═══════════════════════════════════════════════════════
// SISTEMA DE FORMULÁRIOS
// ═══════════════════════════════════════════════════════

enum TipoFormulario {
  pre_consulta // Formulário antes da consulta
  anamnese // Histórico do pet
  pos_consulta // Feedback pós-consulta
  cadastro_pet // Cadastro detalhado do pet
  termo_consentimento // Termos e autorizações
  custom // Formulário personalizado
}

enum StatusFormulario {
  ativo
  inativo
  arquivado
}

model Formulario {
  id            String           @id @default(uuid())
  tenant_id     String
  titulo        String
  descricao     String?
  tipo          TipoFormulario
  status        StatusFormulario @default(ativo)
  campos        String // JSON com definição dos campos
  obrigatorio   Boolean          @default(false)
  criado_por    String? // ID do usuário que criou
  criado_em     DateTime         @default(now())
  atualizado_em DateTime         @updatedAt

  // Relações
  respostas RespostaFormulario[]

  @@index([tenant_id])
  @@index([tenant_id, tipo])
  @@index([tenant_id, status])
  @@map("formularios")
}

model RespostaFormulario {
  id             String   @id @default(uuid())
  tenant_id      String
  formulario_id  String
  usuario_id     String // Quem respondeu
  atendimento_id String? // Vinculado a um atendimento?
  pet_id         String? // Vinculado a um pet?
  respostas      String // JSON com as respostas
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  // Relações
  formulario Formulario @relation(fields: [formulario_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([formulario_id])
  @@index([usuario_id])
  @@index([atendimento_id])
  @@index([criado_em])
  @@map("respostas_formulario")
}

// ═══════════════════════════════════════════════════════
// SISTEMA DE MODERAÇÃO E BANIMENTO
// ═══════════════════════════════════════════════════════

enum TipoViolacao {
  spam // Envio de spam
  abuso_verbal // Linguagem abusiva
  assedio // Assédio a outros usuários
  conteudo_inapropriado // Conteúdo impróprio
  fraude // Tentativa de fraude
  informacao_falsa // Informações falsas sobre credenciais
  violacao_termos // Violação dos termos de uso
  other // Outro tipo
}

enum StatusViolacao {
  pendente // Aguardando análise
  em_analise // Em análise pela moderação
  confirmada // Violação confirmada
  rejeitada // Não caracteriza violação
  resolvida // Violação resolvida
}

enum TipoPunicao {
  advertencia // Apenas advertência
  suspensao_temp // Suspensão temporária
  suspensao_perm // Suspensão permanente (banimento)
  restricao_funcao // Restrição de funcionalidade específica
}

model Violacao {
  id            String         @id @default(uuid())
  tenant_id     String
  usuario_id    String // Usuário que cometeu a violação
  reportado_por String? // Usuário que reportou (pode ser sistema)
  tipo          TipoViolacao
  status        StatusViolacao @default(pendente)
  descricao     String
  evidencias    String? // JSON com evidências (links, screenshots, etc)
  gravidade     Int            @default(1) // 1-5 (1=leve, 5=grave)
  pontos        Int            @default(1) // Pontos de penalidade
  criado_em     DateTime       @default(now())
  analisado_em  DateTime?
  analisado_por String? // Admin que analisou
  resolucao     String? // Texto explicando a resolução

  // Relações
  punicoes Punicao[]

  @@index([tenant_id])
  @@index([usuario_id])
  @@index([status])
  @@index([tipo])
  @@index([criado_em])
  @@map("violacoes")
}

model Punicao {
  id               String      @id @default(uuid())
  tenant_id        String
  usuario_id       String // Usuário punido
  violacao_id      String // Violação que originou a punição
  tipo             TipoPunicao
  motivo           String
  inicio_em        DateTime    @default(now())
  termina_em       DateTime? // NULL para punições permanentes
  ativa            Boolean     @default(true)
  aplicada_por     String // Admin que aplicou
  revogada_em      DateTime?
  revogada_por     String? // Admin que revogou
  motivo_revogacao String?
  criado_em        DateTime    @default(now())

  // Relações
  violacao Violacao @relation(fields: [violacao_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([usuario_id])
  @@index([usuario_id, ativa])
  @@index([termina_em])
  @@map("punicoes")
}

model HistoricoModeracaoUsuario {
  id                 String    @id @default(uuid())
  tenant_id          String
  usuario_id         String
  total_violacoes    Int       @default(0)
  total_pontos       Int       @default(0)
  advertencias       Int       @default(0)
  suspensoes_temp    Int       @default(0)
  suspensoes_perm    Int       @default(0)
  ultima_violacao_em DateTime?
  banido             Boolean   @default(false)
  atualizado_em      DateTime  @updatedAt

  @@unique([tenant_id, usuario_id])
  @@index([tenant_id])
  @@index([usuario_id])
  @@index([banido])
  @@map("historico_moderacao_usuario")
}

// ═══════════════════════════════════════════════════════
// SISTEMA DE BILLING E PAGAMENTOS
// ═══════════════════════════════════════════════════════

enum TipoTransacao {
  pagamento_atendimento // Pagamento de atendimento
  assinatura_plano // Pagamento de plano mensal
  comissao_plataforma // Comissão da plataforma
  transferencia_vet // Transferência para veterinário
  estorno // Estorno de pagamento
  bonus // Bônus/crédito
}

enum StatusTransacao {
  pendente // Aguardando processamento
  processando // Em processamento
  aprovada // Aprovada
  concluida // Concluída
  falhou // Falhou
  cancelada // Cancelada
  estornada // Estornada
}

enum MetodoPagamento {
  cartao_credito
  cartao_debito
  pix
  boleto
  saldo_wallet // Saldo em carteira
}

model Transacao {
  id                    String          @id @default(uuid())
  tenant_id             String
  tipo                  TipoTransacao
  status                StatusTransacao @default(pendente)
  valor_total           Decimal         @db.Decimal(10, 2) // Valor total da transação
  valor_tutor           Decimal?        @db.Decimal(10, 2) // Quanto o tutor paga
  valor_veterinario     Decimal?        @db.Decimal(10, 2) // Quanto o vet recebe
  valor_plataforma      Decimal?        @db.Decimal(10, 2) // Taxa da plataforma
  percentual_plataforma Decimal         @default(15) @db.Decimal(5, 2) // % da plataforma

  // Vinculações
  atendimento_id String? // Vinculado a um atendimento
  tutor_id       String? // Quem paga
  veterinario_id String? // Quem recebe

  // Pagamento
  metodo_pagamento     MetodoPagamento?
  gateway_transacao_id String? // ID da transação no gateway (Stripe, PagSeguro, etc)
  gateway_resposta     String? // JSON com resposta do gateway

  // Datas
  criado_em     DateTime  @default(now())
  processado_em DateTime?
  concluido_em  DateTime?

  // Observações
  descricao String?
  notas     String?

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([atendimento_id])
  @@index([tutor_id])
  @@index([veterinario_id])
  @@index([criado_em])
  @@map("transacoes")
}

model CarteiraTutor {
  id            String   @id @default(uuid())
  tenant_id     String
  tutor_id      String   @unique
  saldo         Decimal  @default(0) @db.Decimal(10, 2)
  total_gasto   Decimal  @default(0) @db.Decimal(10, 2)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([tenant_id])
  @@index([tutor_id])
  @@map("carteiras_tutor")
}

model CarteiraVeterinario {
  id                String   @id @default(uuid())
  tenant_id         String
  veterinario_id    String   @unique
  saldo_disponivel  Decimal  @default(0) @db.Decimal(10, 2)
  saldo_pendente    Decimal  @default(0) @db.Decimal(10, 2) // Aguardando compensação
  total_recebido    Decimal  @default(0) @db.Decimal(10, 2)
  total_transferido Decimal  @default(0) @db.Decimal(10, 2)
  dados_bancarios   String? // JSON com dados para transferência
  criado_em         DateTime @default(now())
  atualizado_em     DateTime @updatedAt

  @@index([tenant_id])
  @@index([veterinario_id])
  @@map("carteiras_veterinario")
}

model PlanoAssinatura {
  id                  String   @id @default(uuid())
  tenant_id           String
  nome                String // "Básico", "Premium", "Veterinário Pro"
  descricao           String?
  tipo_usuario        String // "tutor", "veterinario"
  valor_mensal        Decimal  @db.Decimal(10, 2)
  /// Percentual de desconto que o plano dá nos atendimentos. Vivia só no texto
  /// de benefícios ("10% de desconto..."), que é vitrine e não regra.
  desconto_pct        Decimal  @default(0) @db.Decimal(5, 2)
  /// Quantos atendimentos por mês recebem o desconto. NULL = todos. NÃO é teto
  /// de atendimento: o tutor sempre pode chamar, com ou sem benefício.
  limite_atendimentos Int? // Limite mensal de atendimentos (NULL = ilimitado)
  beneficios          String // JSON com lista de benefícios
  ativo               Boolean  @default(true)
  criado_em           DateTime @default(now())
  atualizado_em       DateTime @updatedAt

  // Relações
  assinaturas AssinaturaUsuario[]

  @@index([tenant_id])
  @@index([ativo])
  @@map("planos_assinatura")
}

model AssinaturaUsuario {
  id               String    @id @default(uuid())
  tenant_id        String
  usuario_id       String
  plano_id         String
  status           String    @default("ativa") // ativa, cancelada, suspensa, expirada
  valor_mensal     Decimal   @db.Decimal(10, 2)
  inicio_em        DateTime  @default(now())
  proxima_cobranca DateTime
  cancelada_em     DateTime?
  criado_em        DateTime  @default(now())
  atualizado_em    DateTime  @updatedAt

  // Relações
  plano PlanoAssinatura @relation(fields: [plano_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([usuario_id])
  @@index([plano_id])
  @@index([status])
  @@index([proxima_cobranca])
  @@map("assinaturas_usuario")
}

model Fatura {
  id               String           @id @default(uuid())
  tenant_id        String
  usuario_id       String // Quem deve pagar
  descricao        String
  valor            Decimal          @db.Decimal(10, 2)
  status           String           @default("pendente") // pendente, paga, vencida, cancelada
  vencimento       DateTime
  paga_em          DateTime?
  metodo_pagamento MetodoPagamento?
  transacao_id     String? // Vinculada a uma transação
  criado_em        DateTime         @default(now())
  atualizado_em    DateTime         @updatedAt

  @@index([tenant_id])
  @@index([usuario_id])
  @@index([status])
  @@index([vencimento])
  @@map("faturas")
}

model HistoricoFinanceiroTenant {
  id                     String   @id @default(uuid())
  tenant_id              String   @unique
  total_transacoes       Int      @default(0)
  total_faturado         Decimal  @default(0) @db.Decimal(12, 2)
  total_comissao         Decimal  @default(0) @db.Decimal(12, 2)
  total_transferido_vets Decimal  @default(0) @db.Decimal(12, 2)
  mes_referencia         String // "2026-01"
  atualizado_em          DateTime @updatedAt

  @@index([tenant_id])
  @@index([mes_referencia])
  @@map("historico_financeiro_tenant")
}

// ═══════════════════════════════════════════════════════
// GATEWAY DE PAGAMENTOS
// ═══════════════════════════════════════════════════════

enum GatewayTipo {
  stripe
  mercado_pago
  paypal
}

enum AmbienteGateway {
  sandbox
  production
}

model GatewayConfig {
  id        String          @id @default(uuid())
  tenant_id String
  gateway   GatewayTipo
  ambiente  AmbienteGateway @default(sandbox)

  // Credenciais criptografadas (AES-256-GCM)
  public_key_encrypted     String? // Client ID / Public Key
  secret_key_encrypted     String // Secret Key (criptografado)
  webhook_secret_encrypted String? // Webhook Secret (criptografado)

  // Configurações extras (JSON)
  configuracao_extra String? @db.Text

  // Status
  ativo       Boolean   @default(true)
  testado_em  DateTime? // Última vez que testou conexão
  ultimo_erro String?   @db.Text

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@unique([tenant_id, gateway]) // Um gateway por tenant
  @@index([tenant_id])
  @@index([gateway])
  @@index([ativo])
  @@map("gateway_configs")
}

// ═══════════════════════════════════════════════════════
// CONTEÚDO, LEADS E ANALYTICS PRÓPRIO
// ═══════════════════════════════════════════════════════

enum LeadStatus {
  novo
  contatado
  qualificado
  convertido
  perdido
  arquivado
}

enum BlogPostStatus {
  rascunho
  agendado
  publicado
}

model VisitSession {
  id                   String   @id @default(uuid())
  tenant_id            String
  anonymous_visitor_id String
  anonymous_session_id String
  first_path           String
  referrer             String?
  utm_source           String?
  utm_medium           String?
  utm_campaign         String?
  utm_content          String?
  utm_term             String?
  device_category      String?
  browser_family       String?
  ip_hash              String?
  is_bot               Boolean  @default(false)
  started_at           DateTime @default(now())
  last_seen_at         DateTime @default(now())

  page_views PageView[]
  leads      Lead[]

  @@unique([tenant_id, anonymous_session_id])
  @@index([tenant_id, started_at])
  @@index([tenant_id, anonymous_visitor_id])
  @@index([tenant_id, utm_source])
  @@index([tenant_id, utm_campaign])
  @@map("visit_sessions")
}

model PageView {
  id              String   @id @default(uuid())
  tenant_id       String
  session_id      String
  navigation_id   String
  path            String
  page_title      String?
  referrer        String?
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  utm_content     String?
  utm_term        String?
  device_category String?
  article_slug    String?
  occurred_at     DateTime @default(now())

  session VisitSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, navigation_id])
  @@index([tenant_id, occurred_at])
  @@index([tenant_id, path])
  @@index([tenant_id, utm_source])
  @@index([tenant_id, utm_campaign])
  @@index([tenant_id, article_slug])
  @@map("page_views")
}

model Lead {
  id                     String     @id @default(uuid())
  tenant_id              String
  session_id             String?
  name                   String
  phone                  String
  email                  String?
  city                   String?
  state                  String?
  pet_name               String?
  pet_type               String?
  interest               String
  preferred_contact_time String?
  privacy_accepted       Boolean
  privacy_accepted_at    DateTime
  privacy_purpose        String
  status                 LeadStatus @default(novo)
  source_page            String?
  referrer               String?
  utm_source             String?
  utm_medium             String?
  utm_campaign           String?
  utm_content            String?
  utm_term               String?
  notes                  String?
  archived_at            DateTime?
  external_id            String? // id do lead na origem externa (ex: leadgen_id do Meta Lead Ads), pra evitar duplicar em retry de webhook
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  session VisitSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, external_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, status])
  @@index([tenant_id, source_page])
  @@index([tenant_id, utm_campaign])
  @@index([tenant_id, session_id])
  @@map("leads")
}

model BlogCategory {
  id          String   @id @default(uuid())
  tenant_id   String
  slug        String
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  posts BlogPost[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, name])
  @@map("blog_categories")
}

model BlogPost {
  id              String         @id @default(uuid())
  tenant_id       String
  slug            String
  title           String
  excerpt         String
  content         String         @db.Text
  content_format  String         @default("markdown")
  cover_image     String?
  cover_image_alt String?
  author_name     String
  author_id       String?
  category_id     String?
  tags            String[]       @default([])
  status          BlogPostStatus @default(rascunho)
  seo_title       String?
  seo_description String?
  social_image    String?
  published_at    DateTime?
  scheduled_for   DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  category BlogCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, slug])
  @@index([tenant_id, status, published_at])
  @@index([tenant_id, category_id])
  @@index([tenant_id, scheduled_for])
  @@map("blog_posts")
}

// ═══════════════════════════════════════════════════════
// INTEGRAÇÃO META (WhatsApp Cloud API)
// ═══════════════════════════════════════════════════════

// Referências a Usuario/Solicitacao são armazenadas como id solto (sem @relation
// no Prisma) de propósito: essa tabela é escrita a partir de um webhook externo,
// então não deve travar em FK caso o registro relacionado já não exista mais.
model WhatsappMessage {
  id             String   @id @default(uuid())
  tenant_id      String
  direction      String // 'inbound' | 'outbound'
  wa_message_id  String?  @unique // id da mensagem na Meta, evita duplicar em retry de webhook
  wa_phone       String // telefone do contato em E.164 sem "+", ex: 5511999999999
  usuario_id     String?
  solicitacao_id String?
  template_name  String?
  body           String?  @db.Text
  status         String   @default("enviada") // enviada|entregue|lida|falhou|recebida
  error_detail   String?
  created_at     DateTime @default(now())

  @@index([tenant_id, wa_phone])
  @@index([tenant_id, created_at])
  @@index([tenant_id, usuario_id])
  @@map("whatsapp_messages")
}

