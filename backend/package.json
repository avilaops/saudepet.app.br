{
  "name": "saude-pet-backend",
  "version": "1.0.0",
  "description": "Backend API para Saúde Pet",
  "main": "src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:blog": "node prisma/seed-blog.js",
    "content:assign-blog-images": "node scripts/assign-blog-images.js",
    "content:optimize-banners": "node scripts/optimize-published-banners.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cross-env NODE_ENV=test jest --testPathIgnorePatterns=/node_modules/ /coverage/ /dist/ /tests/e2e/ --coverage",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest tests/e2e --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:watchAll": "cross-env NODE_ENV=test jest --watchAll",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --coverageReporters=html",
    "test:routes": "cross-env NODE_ENV=test jest tests/integration/routes --runInBand",
    "test:controllers": "cross-env NODE_ENV=test jest tests/unit/controllers",
    "test:services": "cross-env NODE_ENV=test jest tests/unit/services",
    "test:ci": "cross-env NODE_ENV=test CI=true jest --ci --coverage --maxWorkers=2",
    "security:secrets": "node scripts/check-secrets.js",
    "prebuild": "node ../scripts/verificar-dados-falsos.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@prisma/client": "^5.9.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "form-data": "^4.0.6",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.4.0",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.6.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "pg": "^8.20.0",
    "prisma": "^5.9.1",
    "semver": "^6.3.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
