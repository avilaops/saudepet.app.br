# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔧 APP FRONTEND (React + Vite PWA) - TEMPLATE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 📝 INSTRUÇÕES:
# 1. Copie este arquivo para .env.development (dev local)
# 2. Copie este arquivo para .env.production (produção)
# 3. Ajuste os valores conforme necessário
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ────────────────────────────────────────────────────────────────
# 🌐 API URLs
# ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
VITE_PUBLIC_SITE_URL=http://localhost:5173

# URL completa do canal oficial, somente após validação da operação.
VITE_WHATSAPP_URL=

# ────────────────────────────────────────────────────────────────
# 🗺️ Mapa
# ────────────────────────────────────────────────────────────────
# Vazio = imagens gratuitas do OpenStreetMap, que é o padrão hoje. O servidor
# público da comunidade não é dimensionado para tráfego de aplicativo; no dia em
# que ele deixar de servir, estas duas linhas trocam o provedor (ou apontam para
# um nosso) sem tocar em componente nenhum. A atribuição é exigência da licença
# — quem trocar a camada troca o crédito junto.
VITE_MAPA_TILES=
VITE_MAPA_ATRIBUICAO=
