# Configuração de Testes - Saúde Pet
# Copie este arquivo para .env para personalizar

# URLs dos Serviços
BASE_URL=http://localhost:5173
API_URL=http://localhost:3000/api

# Credenciais de Teste
TEST_ADMIN_EMAIL=admin@saudepet.com
TEST_ADMIN_PASSWORD=admin123

TEST_VET_EMAIL=ricardo@teste.com
TEST_VET_PASSWORD=12345678

TEST_TUTOR_EMAIL=abraao.saantos@gmail.com
TEST_TUTOR_PASSWORD=12345678

# Configurações do Playwright
HEADLESS=true
SLOW_MO=0
TIMEOUT=30000

# Screenshots e Vídeos
SCREENSHOT=only-on-failure
VIDEO=retain-on-failure

# Configurações de Docker
DOCKER_POSTGRES_PORT=5435
DOCKER_BACKEND_PORT=3002
DOCKER_FRONTEND_PORT=5175
DOCKER_MAILHOG_SMTP_PORT=1025
DOCKER_MAILHOG_WEB_PORT=8025

# Configurações de CI/CD
CI=false
WORKERS=undefined
RETRIES=0

# Debug
DEBUG=false
TRACE=on-first-retry
